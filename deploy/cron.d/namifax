# /etc/cron.d/namifax -- housekeeping (the original's avantfaxcron).  Edit the user and the day counts, then install as root.
# cron has no EnvironmentFile, so every command is wrapped in `sh -c` that first reads /etc/namifax.env (KEY=value lines, no
# quotes, no `export`; `set -a` exports them) -- the same file the systemd services and the HylaFAX hooks read.  Without it the
# command would not see DATABASE_URL and would fall back to a SQLite file in the current folder.
# Clean the temporary folder every night:
0 0 * * *   uucp  sh -c 'set -a; [ -r /etc/namifax.env ] && . /etc/namifax.env; set +a; exec /opt/namifax/.venv/bin/namifax cron -t 2'
# Move faxes older than 30 days out of the inbox into the archive (-i), and delete archived faxes older than 365 days (-d):
# 30 1 * * *  uucp  sh -c 'set -a; [ -r /etc/namifax.env ] && . /etc/namifax.env; set +a; exec /opt/namifax/.venv/bin/namifax cron -t 2 -i 30 -d 365'
# Remove the TIFF of faxes older than 90 days when a PDF exists (-p):
# 45 1 * * *  uucp  sh -c 'set -a; [ -r /etc/namifax.env ] && . /etc/namifax.env; set +a; exec /opt/namifax/.venv/bin/namifax cron -t 2 -p 90'
# Run the storage policy saved on the Admin > Storage page (-s):
# 0 2 * * *   uucp  sh -c 'set -a; [ -r /etc/namifax.env ] && . /etc/namifax.env; set +a; exec /opt/namifax/.venv/bin/namifax cron -t 2 -s'
