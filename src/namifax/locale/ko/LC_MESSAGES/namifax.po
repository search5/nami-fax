msgstr "사용자 이름에는 영문자·숫자·밑줄·점만 쓸 수 있습니다."

#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"This email contains your username and password to log into NamiFAX (%(url)s)\n"
"\n"
"Username - %(username)s\n"
"Password - %(password)s\n"
"\n"
"Please do not respond to this message as it is automatically generated and is for information purposes only"
msgstr ""
"%(name)s님, 안녕하세요.\n"
"\n"
"이 메일에는 NamiFAX(%(url)s)에 로그인할 사용자 이름과 비밀번호가 들어 있습니다.\n"
"\n"
"사용자 이름 - %(username)s\n"
"비밀번호 - %(password)s\n"
"\n"
"이 메일은 자동으로 발송된 안내이므로 회신하지 마세요."

msgid "New User Details"
msgstr "새 사용자 정보"

msgid "The user does not exist."
msgstr "사용자가 없습니다."

msgid "You cannot delete your own account."
msgstr "자신의 계정은 삭제할 수 없습니다."

msgid "You cannot delete the last superuser."
msgstr "마지막 슈퍼유저는 삭제할 수 없습니다."

msgid "Please enter a valid number."
msgstr "올바른 숫자를 입력하십시오."

msgid "Both sent and received faxes"
msgstr "보낸 팩스와 받은 팩스 모두"

msgid "Only sent faxes"
msgstr "보낸 팩스만"

msgid "Only received faxes"
msgstr "받은 팩스만"

msgid "SAML sign-in is not set up on this server."
msgstr "이 서버에는 SAML 로그인이 설정되어 있지 않습니다."

msgid "The identity provider sent no answer."
msgstr "ID 공급자(IdP)가 응답을 보내지 않았습니다."

msgid "The identity provider's answer could not be accepted. Start the sign-in again."
msgstr "ID 공급자의 응답을 받아들일 수 없었습니다. 로그인을 처음부터 다시 시작하십시오."

msgid "No account here matches the identity provider's answer."
msgstr "ID 공급자가 알려 준 사용자와 일치하는 계정이 없습니다."

msgid "Account is disabled"
msgstr "사용이 중지된 계정입니다"

msgid "Too many failed sign-in attempts. Please try again later."
msgstr "로그인 실패가 너무 많습니다. 잠시 후 다시 시도하십시오."

#, python-format
msgid "Too many failed attempts. Try again in %(minutes)d minutes."
msgstr "실패 횟수가 너무 많습니다. %(minutes)d분 뒤에 다시 시도하십시오."

msgid "Invalid or expired verification code."
msgstr "유효하지 않거나 만료된 인증 코드입니다."

#, python-format
msgid ""
"The user account %(user)s has this email associated with it.  A web user from %(ip)s has just requested that a new password be sent.\n"
"\n"
"Your New Password is: %(password)s\n"
"\n"
"If this was an error just login with your new password and then change your password to what you would like it to be."
msgstr ""
"사용자 계정 %(user)s에 이 이메일 주소가 등록되어 있습니다.  %(ip)s의 웹 사용자가 방금 새 비밀번호를 보내 달라고 요청했습니다.\n"
"\n"
"새 비밀번호: %(password)s\n"
"\n"
"요청하신 적이 없다면 새 비밀번호로 로그인한 뒤 원하는 비밀번호로 바꾸십시오."

msgid "Email failed to send"
msgstr "이메일을 보내지 못했습니다"

msgid "Fax Contacts"
msgstr "팩스 연락처"

msgid "Email Contacts"
msgstr "이메일 연락처"

msgid "The fax document was not found."
msgstr "팩스 문서를 찾을 수 없습니다."

msgid "The email failed to send."
msgstr "메일을 보내지 못했습니다"

