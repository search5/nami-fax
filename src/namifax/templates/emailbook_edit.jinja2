{% extends "layout.jinja2" %}

{% block title %}- NamiFAX - Edit Email Contact - Email Book{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto space-y-6">
  
  <!-- Header & Breadcrumbs -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-sky-50 border border-sky-200 flex items-center justify-center text-sky-700 shadow-2xs">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-slate-900 tracking-tight">{{ _('Email Book - Edit Email Contact') }}</h2>
        <p class="text-xs text-slate-500">{{ _('Manage contact information and company affiliation in Email Book.') }}</p>
      </div>
    </div>
    
    <div class="flex items-center space-x-2">
      <a href="/emailbook" class="px-3.5 py-1.5 bg-white hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-semibold border border-slate-300 shadow-2xs transition">
        &larr; {{ _('Back to Email Book') }}
      </a>
    </div>
  </div>

  {% if error %}<div class="p-3 bg-rose-50 border border-rose-200 rounded-lg text-rose-700 text-xs">{{ error }}</div>{% endif %}
  {% if message %}<div class="p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-700 text-xs">{{ message }}</div>{% endif %}

  {% if not contact.id %}
  <form action="/upload/contacts" method="post" enctype="multipart/form-data" class="bg-white border border-slate-200/90 rounded-xl p-4 shadow-xs flex flex-wrap items-center gap-3 text-xs">
    <span class="font-semibold text-slate-700">{{ _('Upload contacts file (vCard)') }}</span>
    <input type="file" name="upload" accept=".vcf,text/vcard,text/x-vcard,text/plain" class="w-full border border-slate-300 rounded-lg px-3 py-1.5 text-xs bg-white flex-1 min-w-[12rem]" />
    <input type="hidden" name="_submit_check" value="1" />
    <button type="submit" class="px-4 py-1.5 bg-slate-800 hover:bg-slate-700 text-white rounded-lg font-semibold transition">{{ _('Upload') }}</button>
  </form>
  {% endif %}

  <!-- Form Container -->
  <form action="/emailbook/edit" method="post" class="space-y-6 text-xs">
    
    <div class="bg-white border border-slate-200/90 rounded-xl p-5 shadow-xs space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-100 pb-3">
        <span class="w-2 h-2 rounded-full bg-sky-600"></span>
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">{{ _('Contact Profile Details') }}</h3>
      </div>

      <div>
        <label for="contact_name" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Contact Name') }} *</label>
        <input type="text" name="contact_name" id="contact_name" value="{{ contact.name or '' }}" required class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="{{ _('John Doe') }}" />
      </div>

      <div>
        <label for="contact_email" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Email Address') }} *</label>
        <input type="email" name="contact_email" id="contact_email" value="{{ contact.email or '' }}" required class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 font-mono text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="user@domain.com" />
      </div>

      <!-- Hidden Identity Keys -->
      {% if contact.id %}<input type="hidden" name="abookemail_id" value="{{ contact.id }}" />{% endif %}
      <input type="hidden" name="_submit_check" value="1" />
    </div>

    <!-- Actions (Strict W67 Button Sequence: delete -> save) -->
    <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
      <div>
        {% if contact.id and can_del %}
        <button type="submit" name="delete" value="1" class="px-5 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg font-bold text-xs transition" onclick="return confirm('Are you sure you want to delete this contact?');">
          {{ _('Delete') }}
        </button>
        {% endif %}
      </div>
      <div class="space-x-3">
        <a href="/emailbook" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-lg font-semibold hover:bg-slate-200 transition">{{ _('Cancel') }}</a>
        {% if contact.id %}
        <button type="submit" name="save" value="1" class="px-6 py-2.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold shadow-2xs transition">{{ _('Save') }}</button>
        {% else %}
        <button type="submit" name="create" value="1" class="px-6 py-2.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold shadow-2xs transition">{{ _('Save') }}</button>
        {% endif %}
      </div>
    </div>
  </form>

</div>
{% endblock %}


