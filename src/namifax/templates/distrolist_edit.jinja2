{% extends "layout.jinja2" %}
 
{% block title %}NamiFAX - Distribution Lists{% endblock %}
 
{% block content %}
<div class="max-w-2xl mx-auto space-y-6">
  
  <!-- Header & Breadcrumbs -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-sky-50 border border-sky-200 flex items-center justify-center text-sky-700 shadow-2xs">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-slate-900 tracking-tight">
          {% if selected_list %}{{ _('Edit Distribution List') }} - {{ selected_list.listname }}{% else %}{{ _('Create Distribution List') }}{% endif %}
        </h2>
        <p class="text-xs text-slate-500">{{ _('Configure broadcast list parameters and recipient group members.') }}</p>
      </div>
    </div>
    
    <div class="flex items-center space-x-2">
      <a href="/distrolist" class="px-3.5 py-1.5 bg-white hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-semibold border border-slate-300 shadow-2xs transition">
        &larr; {{ _('Back to Lists') }}
      </a>
    </div>
  </div>

  {% if error %}<div class="p-3 bg-rose-50 border border-rose-200 rounded-lg text-rose-700 text-xs">{{ error }}</div>{% endif %}
  <form action="/distrolist/edit" method="post" class="space-y-6 text-xs">
    {% if selected_list %}
      <input type="hidden" name="dl_id" value="{{ selected_list.dl_id }}" />
    {% endif %}
    <input type="hidden" name="_submit_check" value="1" />

    <!-- List Details Card -->
    <div class="bg-white border border-slate-200/90 rounded-xl p-5 shadow-xs space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-100 pb-3">
        <span class="w-2 h-2 rounded-full bg-sky-600"></span>
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">{{ _('Distribution List Profile') }}</h3>
      </div>

      <div>
        <label for="listname" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('List Name') }} *</label>
        <input type="text" name="listname" id="listname" required value="{{ selected_list.listname if selected_list else '' }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" placeholder="{{ _('e.g. Finance Operations') }}" />
      </div>

      {% if selected_list %}
        <div class="space-y-2 pt-2">
          <div class="flex items-center justify-between">
            <span class="font-bold text-slate-700 uppercase tracking-wider text-[11px]">{{ _('Enrolled Members') }} ({{ selected_list.members|length }})</span>
            <span class="text-[11px] font-mono text-slate-400">{{ _('List ID:') }} #{{ selected_list.dl_id }}</span>
          </div>
          <div class="border border-slate-200/80 rounded-xl divide-y divide-slate-100 max-h-48 overflow-y-auto bg-slate-50/30">
            {% for m in selected_list.members %}
              <div class="p-2.5 flex justify-between items-center text-xs">
                <span class="font-semibold text-slate-800">{{ m.company }}</span>
                <span class="text-slate-500 font-mono text-[11px]">{{ m.faxnumber }}</span>
              </div>
            {% else %}
              <div class="p-4 text-center text-slate-400">{{ _('No contacts in this list.') }}</div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Actions (Strict W66 Button Sequence: delete -> save) -->
    <div class="pt-4 border-t border-slate-200">
      {% if selected_list %}
        <div class="flex items-center justify-between">
          <button type="submit" name="delete" value="1" class="px-5 py-2.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg font-bold text-xs transition" onclick="return confirm('Are you sure you want to delete this distribution list?');">
            {{ _('Delete') }}
          </button>
          <div class="space-x-3">
            <a href="/distrolist" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-lg font-semibold hover:bg-slate-200 transition">{{ _('Cancel') }}</a>
            <button type="submit" name="save" value="1" class="px-6 py-2.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold shadow-2xs transition">
              {{ _('Save') }}
            </button>
          </div>
        </div>
      {% else %}
        <div class="flex items-center justify-end space-x-3">
          <a href="/distrolist" class="px-5 py-2.5 bg-slate-100 text-slate-700 rounded-lg font-semibold hover:bg-slate-200 transition">{{ _('Cancel') }}</a>
          <button type="submit" name="save" value="1" class="px-6 py-2.5 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold shadow-2xs transition">
            {{ _('Save') }}
          </button>
        </div>
      {% endif %}
    </div>
  </form>
</div>
{% endblock %}

