<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/static/css/main.css?v=3.6.0" type="text/css" />
</head>
<body class="bg-slate-50 text-slate-800 p-4">
  <div class="max-w-lg mx-auto bg-white p-5 rounded-xl shadow border border-slate-200 space-y-4">
    <h2 class="text-base font-bold text-sky-900">{{ _('Add contacts to the list') }}</h2>
    {% if added %}<div class="p-2 bg-emerald-50 border border-emerald-200 rounded text-emerald-700 text-sm">{{ _('Changes saved') }}</div>{% endif %}
    {% if error %}<div class="p-2 bg-rose-50 border border-rose-200 rounded text-rose-700 text-sm">{{ error }}</div>{% endif %}

    <form action="/helper/distrolist" method="get" class="flex gap-2">
      <input type="hidden" name="dl_id" value="{{ dl_id }}" />
      <input type="text" name="regexp" id="regexp" value="{{ query }}" placeholder="{{ _('Search') }}" autofocus class="flex-1 border border-slate-300 rounded px-3 py-1.5 text-sm" />
      <button type="submit" class="px-3 py-1.5 bg-slate-200 rounded text-sm font-semibold">{{ _('Search') }}</button>
    </form>

    <form action="/helper/distrolist" method="post" class="space-y-3">
      <select name="myselect[]" id="myselect" multiple="multiple" size="8" class="w-full border border-slate-300 rounded p-1 text-sm">
        {% for o in options %}<option value="{{ o.value }}">{{ o.label }}</option>{% endfor %}
      </select>
      <input type="hidden" name="dl_id" value="{{ dl_id }}" />
      <input type="hidden" name="_submit_check" value="1" />
      <div class="flex justify-end gap-2">
        <button type="submit" name="add" value="1" class="px-4 py-1.5 bg-sky-700 hover:bg-sky-600 text-white rounded text-sm font-semibold">{{ _('Add') }}</button>
        <a href="/distrolist?dl_id={{ dl_id }}" class="px-4 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded text-sm font-semibold">{{ _('Back') }}</a>
      </div>
    </form>
  </div>
</body>
</html>
