{% extends "layout.jinja2" %}

{% block title %}NamiFAX — Outbox{% endblock %}

{% block extra_head %}<meta http-equiv="refresh" content="60;URL=/outbox" />{% endblock %}

{% block content %}
<div class="space-y-5">

  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-slate-900">{{ _('Outbox') }}</h1>
      <p class="text-sm text-slate-500 mt-0.5">{{ _('Faxes currently queued or being transmitted.') }}</p>
    </div>
    <a href="/sendfax"
       class="inline-flex items-center gap-1.5 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-sm transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
      </svg>
      {{ _('Send Fax') }}
    </a>
  </div>

  {% if flash_message %}
  <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm flex items-center gap-3">
    <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
    </svg>
    <span>{{ flash_message }}</span>
  </div>
  {% endif %}

  <!-- Info banner -->
  <div class="flex items-start gap-3 p-4 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-800">
    <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    <p>{{ _('This page shows only faxes that are queued or in progress. Once delivered, they are removed from this list. Find completed records in the') }} <a href="/archive" class="underline font-semibold">{{ _('Archive') }}</a>.</p>
  </div>

  {% if jobs %}
  <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/60">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
        {{ jobs|length }} {{ _('jobs in progress') if jobs|length != 1 else _('job in progress') }}
      </span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-slate-100 bg-slate-50/80">
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Job ID') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Priority') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('User') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Company') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Pages') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Dials') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('TTS') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Status') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider text-right">{{ _('Actions') }}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {% for j in jobs %}
          <tr class="hover:bg-slate-50/60 transition-colors" data-jid="{{ j.jid }}">
            <td class="py-3 px-4 font-mono text-sm font-bold text-slate-700">{{ j.jid }}</td>
            <td class="py-3 px-4 font-mono text-xs text-slate-600">{{ j.pri }}</td>
            <td class="py-3 px-4 text-sm text-slate-700">{{ j.user }}</td>
            <td class="py-3 px-4 text-sm text-slate-600 truncate max-w-xs">{{ j.company or '—' }}</td>
            <td class="py-3 px-3 text-center font-mono text-xs text-slate-700">{{ j.pages }}</td>
            <td class="py-3 px-3 text-center font-mono text-xs text-slate-700">{{ j.dials }}</td>
            <td class="py-3 px-4 font-mono text-xs text-slate-600">{{ j.tts or '' }}</td>
            <td class="py-3 px-4 text-sm text-slate-700">{{ (j.status or '')|replace('_', ' ') }}</td>
            <td class="py-3 px-4 text-right whitespace-nowrap">
              <a href="/ajax/faxalter?jid={{ j.jid }}&owner={{ j.owner|urlencode }}" title="{{ _('Modify Job') }}"
                 class="inline-flex items-center px-3 py-1.5 bg-white hover:bg-blue-50 border border-slate-200 hover:border-blue-200 text-blue-700 rounded-lg text-xs font-semibold transition-colors">{{ _('Modify') }}</a>
              <form method="post" action="/outbox" class="inline" onsubmit="return confirm('{{ _('Kill job') }} {{ j.jid }}?')">
                <input type="hidden" name="kill" value="{{ j.jid }}" />
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                <button type="submit" title="{{ _('Kill job') }}"
                        class="inline-flex items-center px-3 py-1.5 bg-white hover:bg-red-50 border border-slate-200 hover:border-red-200 text-red-600 rounded-lg text-xs font-semibold transition-colors">{{ _('Kill') }}</button>
              </form>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

  {% if failed_jobs %}
  <div class="bg-white border border-red-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-red-100 bg-red-50/50 flex items-center gap-2">
      <h2 class="text-sm font-semibold text-red-900">{{ _('Failed Transmissions') }} — {{ failed_jobs|length }}</h2>
      <p class="text-xs text-red-500 ml-1">{{ _('Review the number or retry below.') }}</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-red-100 bg-red-50/30">
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider">{{ _('Job ID') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider">{{ _('Priority') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider">{{ _('User') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider">{{ _('Company') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider">{{ _('Pages') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider">{{ _('Dials') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider">{{ _('Status') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-red-600 uppercase tracking-wider text-right">{{ _('Actions') }}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-red-50">
          {% for j in failed_jobs %}
          <tr class="hover:bg-slate-50/60 transition-colors" data-jid="{{ j.jid }}">
            <td class="py-3 px-4 font-mono text-sm font-bold text-slate-700">{{ j.jid }}</td>
            <td class="py-3 px-4 font-mono text-xs text-slate-600">{{ j.pri }}</td>
            <td class="py-3 px-4 text-sm text-slate-700">{{ j.user }}</td>
            <td class="py-3 px-4 text-sm text-slate-600 truncate max-w-xs">{{ j.company or '—' }}</td>
            <td class="py-3 px-3 text-center font-mono text-xs text-slate-700">{{ j.pages }}</td>
            <td class="py-3 px-3 text-center font-mono text-xs text-slate-700">{{ j.dials }}</td>
            <td class="py-3 px-4 text-sm text-red-700 font-medium">{{ (j.status or '')|replace('_', ' ') }}</td>
            <td class="py-3 px-4 text-right whitespace-nowrap">
              <a href="/ajax/faxalter?jid={{ j.jid }}&r=1&owner={{ j.owner|urlencode }}" title="{{ _('Modify Job') }}"
                 class="inline-flex items-center px-3 py-1.5 bg-white hover:bg-blue-50 border border-slate-200 hover:border-blue-200 text-blue-700 rounded-lg text-xs font-semibold transition-colors">{{ _('Retry') }}</a>
              <form method="post" action="/outbox" class="inline" onsubmit="return confirm('{{ _('Kill job') }} {{ j.jid }}?')">
                <input type="hidden" name="kill" value="{{ j.jid }}" />
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                <button type="submit" title="{{ _('Kill job') }}"
                        class="inline-flex items-center px-3 py-1.5 bg-white hover:bg-red-50 border border-slate-200 hover:border-red-200 text-red-600 rounded-lg text-xs font-semibold transition-colors">{{ _('Kill') }}</button>
              </form>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

  {% if not jobs and not failed_jobs %}
  <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-12 text-center">
    <h3 class="text-base font-bold text-slate-800">{{ _('No jobs in queue') }}</h3>
    <p class="text-sm text-slate-500 mt-1.5 max-w-xs mx-auto">{{ _('There are no faxes waiting to be sent. Send a fax to see its progress here.') }}</p>
    <a href="/sendfax" class="mt-5 inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold shadow-sm transition-colors">{{ _('Send a Fax') }}</a>
  </div>
  {% else %}
  <div class="text-center text-xs text-slate-500">{{ queue_count }} {{ _('faxes') }}</div>
  {% endif %}

</div>
{% endblock %}
