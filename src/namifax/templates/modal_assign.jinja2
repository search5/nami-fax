<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900/50 backdrop-blur-xs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>- NamiFAX - Assign Company</title>
  <link rel="icon" href="/static/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/static/css/main.css?v=3.6.0" type="text/css" />
</head>
<body class="min-h-full flex items-center justify-center p-4 sm:p-6 font-sans antialiased text-slate-800">

  <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl border border-slate-200/90 overflow-hidden">
    
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/70">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-lg bg-sky-50 border border-sky-200 flex items-center justify-center text-sky-700 shadow-2xs">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <div>
          <h1 class="text-sm font-bold text-slate-900 tracking-tight">{{ _('Assign Company Name') }}</h1>
          <p class="text-[11px] text-slate-500">{{ _('Associate document with registered enterprise contact') }}</p>
        </div>
      </div>
      <button type="button" onclick="window.close()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Form (Strict W32 Sequence Contract) -->
    <form action="/assign" method="post" class="p-6 space-y-4 text-xs">
      {% if error %}<div class="p-3 bg-rose-50 border border-rose-200 rounded-lg text-rose-700">{{ error }}</div>{% endif %}
      <div>
        <label for="regexp" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Search Company Name') }}</label>
        <div class="flex items-center gap-2">
          <input type="text" name="regexp" id="regexp" placeholder="{{ _('Type company name to filter...') }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" />
          {% if whitepages_url %}
          <a href="{{ whitepages_url }}" target="_blank" rel="noopener noreferrer" data-whitepages title="{{ _('Search the White Pages') }}" class="shrink-0 p-1 rounded-lg hover:bg-slate-100">
            <img src="/static/images/pb.gif" alt="" class="w-5 h-5" />
          </a>
          {% endif %}
        </div>
      </div>

      <div>
        <label for="myselect" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('Select Contact Record') }}</label>
        <select name="myselect" id="myselect" size="5" class="w-full border border-slate-300 rounded-lg p-2 bg-slate-50/50 text-slate-900 font-medium focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">
          <option value=""></option>
          {% for c in companies %}
            <option value="{{ c.id }}" class="py-1 px-2 hover:bg-sky-50 rounded">{{ c.name }}</option>
          {% endfor %}
        </select>
      </div>

      <input type="hidden" name="abook_id" value="{{ abook_id }}" />
      <input type="hidden" name="_submit_check" value="1" />

      <!-- Action Buttons (Strict Sequence: Cancel -> Save) -->
      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-2.5">
        <button type="button" onclick="window.close()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-semibold text-xs transition">
          {{ _('Cancel') }}
        </button>
        <button type="submit" class="px-5 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">
          {{ _('Save') }}
        </button>
      </div>
    </form>

  </div>

</body>
</html>

