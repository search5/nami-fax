{% extends "layout.jinja2" %}

{% block title %}- NamiFAX - Distribution Lists{% endblock %}

{% block content %}
<div class="space-y-6">
  
  <!-- Header & Navigation Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-sky-50 border border-sky-200 flex items-center justify-center text-sky-700 shadow-2xs">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-slate-900 tracking-tight">{{ _('Distribution Lists') }}</h2>
        <p class="text-xs text-slate-500">{{ _('Organize recipient groups for mass fax broadcasting and notifications.') }}</p>
      </div>
    </div>

    <!-- Navigation Chips & Primary Action -->
    <div class="flex items-center space-x-2">
      <nav class="book-menu inline-flex rounded-lg border border-slate-200 bg-slate-50 p-0.5 text-xs font-semibold mr-2">
        <a href="/emailbook" class="px-3 py-1 rounded-md text-slate-600 hover:text-slate-900 transition">{{ _('Email Book') }}</a>
        <a href="/addressbook" class="px-3 py-1 rounded-md text-slate-600 hover:text-slate-900 transition">{{ _('Address Book') }}</a>
        <a href="/distrolist" class="px-3 py-1 rounded-md bg-white text-sky-800 shadow-2xs font-bold">{{ _('Distribution Lists') }}</a>
      </nav>
      <a href="/distrolist/edit" class="inline-flex items-center space-x-1.5 px-4 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-bold shadow-2xs transition">
        <span>+ {{ _('Create List') }}</span>
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Left Column: Distribution Lists Selector -->
    <div class="bg-white border border-slate-200/90 rounded-xl p-5 shadow-xs space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-100 pb-3">
        <span class="w-2 h-2 rounded-full bg-sky-600"></span>
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">{{ _('Saved Distribution Lists') }}</h3>
      </div>
      
      <input type="text" data-live-filter="#list-picker" placeholder="{{ _('Search') }}" class="w-full border border-slate-300 rounded-lg px-3 py-1.5 text-xs bg-white" />
      <div id="list-picker" class="divide-y divide-slate-100 border border-slate-200/80 rounded-xl overflow-hidden text-xs max-h-[500px] overflow-y-auto">
        {% for dl in distrolists %}
          <a data-filter-item href="/distrolist?dl_id={{ dl.dl_id }}" class="block p-3 hover:bg-slate-50 transition {% if selected_list and selected_list.dl_id == dl.dl_id %}bg-sky-50/70 border-l-4 border-sky-600{% endif %}">
            <div class="flex justify-between items-center">
              <div>
                <span class="font-bold text-slate-900 block">{{ dl.listname }}</span>
                <span class="text-[11px] text-slate-400 font-mono">ID: #{{ dl.dl_id }}</span>
              </div>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-bold">
                {{ dl.members|length if dl.members else dl.members_count }} {{ _('members') }}
              </span>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>

    <!-- Right Column: Group Detail & Member Management (Strict W16 Contract Form) -->
    <div class="lg:col-span-2 bg-white border border-slate-200/90 rounded-xl p-6 shadow-xs space-y-5">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
          <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider">
            {% if selected_list %}{{ selected_list.listname }} - {{ _('Group Members & Settings') }}{% else %}{{ _('Create New Distribution List') }}{% endif %}
          </h3>
        </div>
        {% if selected_list %}
          <span class="text-[11px] font-mono bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-bold">List ID: #{{ selected_list.dl_id }}</span>
        {% endif %}
      </div>

      {% if message %}<div class="p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-700 text-xs">{{ message }}</div>{% endif %}
      {% if error %}<div class="p-3 bg-rose-50 border border-rose-200 rounded-lg text-rose-700 text-xs">{{ error }}</div>{% endif %}
      <form action="/distrolist/edit" method="post" class="space-y-5 text-xs">
        <div>
          <label for="listname" class="block font-semibold text-slate-700 text-xs mb-1.5">{{ _('List Name') }} *</label>
          <div class="flex gap-2">
            <input type="text" name="listname" id="listname" value="{{ selected_list.listname if selected_list else '' }}" required maxlength="100" placeholder="{{ _('e.g. Executive Sales Team') }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" />
            {% if selected_list %}<button type="submit" name="savename" value="1" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-lg font-bold text-xs whitespace-nowrap transition">{{ _('Save list name') }}</button>{% endif %}
          </div>
        </div>

        {% if selected_list %}
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="block font-semibold text-slate-700 text-xs">{{ _('Group Members (Contacts & Fax Numbers)') }}</span>
              <span class="text-[11px] text-slate-500 font-mono font-medium">{{ selected_list.members|length }} {{ _('contacts assigned') }}</span>
            </div>
            <div class="border border-slate-200/90 rounded-xl divide-y divide-slate-100 max-h-72 overflow-y-auto bg-slate-50/30">
              {% for m in selected_list.members %}
                <label class="p-3 flex items-center gap-3 hover:bg-white transition cursor-pointer">
                  <input type="checkbox" name="dl_list[]" value="{{ m.value }}" class="rounded border-slate-300 w-4 h-4" />
                  <span><span class="font-bold text-slate-800">{{ m.company }}</span> - <span class="text-slate-600 font-mono">{{ m.faxnumber }}</span></span>
                </label>
              {% else %}
                <div class="p-6 text-center text-slate-400">{{ _('No contacts assigned to this list yet.') }}</div>
              {% endfor %}
            </div>
            <div class="flex items-center gap-2">
              <a href="/helper/distrolist?dl_id={{ selected_list.dl_id }}" class="px-4 py-2 bg-sky-50 hover:bg-sky-100 text-sky-800 border border-sky-200 rounded-lg font-bold text-xs transition">{{ _('Add Member') }}</a>
              <button type="submit" name="remove" value="1" class="px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 rounded-lg font-semibold text-xs transition">{{ _('Remove entries') }}</button>
            </div>
          </div>
        {% endif %}

        {% if selected_list %}<input type="hidden" name="dl_id" value="{{ selected_list.dl_id }}" />{% endif %}
        <input type="hidden" name="_submit_check" value="1" />

        <div class="pt-4 border-t border-slate-200 flex items-center justify-between">
          {% if selected_list %}
            <button type="submit" name="delete" value="1" onclick="return confirm('{{ _('Delete this distribution list?') }}')" class="px-4 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg font-bold text-xs transition">{{ _('Delete') }}</button>
            <span></span>
          {% else %}
            <span></span>
            <button type="submit" name="create" value="1" class="px-6 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">{{ _('Create List') }}</button>
          {% endif %}
        </div>
      </form>
    </div>

  </div>

</div>
{% endblock %}

