{% extends "admin_layout.jinja2" %}

{% block title %}- NamiFAX - Admin - Configure DID Routing{% endblock %}

{% block content %}
<div class="space-y-6">
  
  <!-- Header & Actions -->
  <div class="border-b border-slate-800 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-sky-950 border border-sky-800 flex items-center justify-center text-sky-400 shadow-inner">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-white tracking-tight">{{ _('Configure DID Routing') }}</h2>
        <p class="text-xs text-slate-400">{{ _('Route incoming faxes by Direct Inward Dialing (DID) extension to specific email boxes or printers') }}</p>
      </div>
    </div>

    <a href="/admin/routing/did" class="inline-flex items-center space-x-1.5 px-4 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-bold shadow-2xs transition">
      <span>+ {{ _('New DID Route') }}</span>
    </a>
  </div>

  {% if message %}
    <div class="p-4 bg-emerald-950/80 border border-emerald-800/80 text-emerald-200 rounded-xl text-xs font-semibold flex items-center space-x-3 shadow-2xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>{{ message }}</span>
    </div>
  {% endif %}
  {% if error %}
    <div class="p-4 bg-rose-950/80 border border-rose-800/80 text-rose-200 rounded-xl text-xs font-semibold flex items-center space-x-3 shadow-2xs">
      <span class="w-2 h-2 rounded-full bg-rose-500"></span>
      <span>{{ error }}</span>
    </div>
  {% endif %}

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- Left: DID Routes List Table -->
    <div class="bg-slate-950/60 border border-slate-800/90 rounded-xl p-5 space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-800 pb-3">
        <span class="w-2 h-2 rounded-full bg-sky-500"></span>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider">{{ _('Active DID Routing Rules') }}</h3>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left border-collapse">
          <thead>
            <tr class="bg-slate-900 border-b border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
              <th scope="col" class="py-2.5 px-3">{{ _('Route Code') }}</th>
              <th scope="col" class="py-2.5 px-3">{{ _('Alias') }}</th>
              <th scope="col" class="py-2.5 px-3">{{ _('Contact') }}</th>
              <th scope="col" class="py-2.5 px-3">{{ _('Printer') }}</th>
              <th scope="col" class="py-2.5 px-3 text-right">{{ _('Action') }}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            {% for r in did_routes %}
              {% set rid = r.didr_id %}
              <tr class="hover:bg-slate-800/40 transition {% if selected_route and selected_route.didr_id == rid %}bg-slate-800/60 border-l-2 border-l-sky-500{% endif %}">
                <td class="py-2.5 px-3 font-mono font-bold text-white">{{ r.route or r.routecode }}</td>
                <td class="py-2.5 px-3 text-slate-300 font-medium">{{ r.alias }}</td>
                <td class="py-2.5 px-3 font-mono text-slate-400">{{ r.contact or '-' }}</td>
                <td class="py-2.5 px-3 font-mono text-slate-400">{{ r.printer or '-' }}</td>
                <td class="py-2.5 px-3 text-right">
                  <a href="/admin/routing/did?didr_id={{ rid }}" class="inline-flex items-center px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-sky-400 text-[11px] font-semibold border border-slate-700 transition">{{ _('Edit') }}</a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Right: DID Route Form (Strict 6 Inputs, 1 Button Contract) -->
    <div class="bg-slate-950/60 border border-slate-800/90 rounded-xl p-5 space-y-4" id="did-form">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <h3 class="text-xs font-bold text-white uppercase tracking-wider">
            {{ _('Configure Routing Rule') }}
            {% if selected_route %}
              <span class="text-sky-400 font-normal lowercase"> (editing #{{ selected_route.route }})</span>
            {% endif %}
          </h3>
        </div>
        {% if selected_route %}
          <span class="px-2 py-0.5 bg-amber-950 text-amber-300 border border-amber-800 text-[10px] font-bold rounded">{{ _('EDIT MODE') }}</span>
        {% else %}
          <span class="px-2 py-0.5 bg-emerald-950 text-emerald-300 border border-emerald-800 text-[10px] font-bold rounded">{{ _('NEW') }}</span>
        {% endif %}
      </div>

      <form action="/admin/routing/did{% if selected_route %}?didr_id={{ selected_route.didr_id }}{% endif %}" method="post" class="space-y-4 text-xs">
        <div>
          <label for="route" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Route Code') }} *</label>
          <input type="text" name="route" id="route" required placeholder="{{ _('e.g. 1000') }}" value="{{ selected_route.route if selected_route else '' }}" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white font-mono focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition" />
        </div>

        <div>
          <label for="alias" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Alias') }} *</label>
          <input type="text" name="alias" id="alias" required placeholder="{{ _('e.g. Sales Direct Line') }}" value="{{ selected_route.alias if selected_route else '' }}" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition" />
        </div>

        <div>
          <label for="contact" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Contact Email') }}</label>
          <input type="email" name="contact" id="contact" placeholder="inbound@namifax.local" value="{{ selected_route.contact if selected_route else '' }}" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white font-mono focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition" />
        </div>

        <div>
          <label for="printer" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Printer') }}</label>
          <input type="text" name="printer" id="printer" placeholder="lp1" value="{{ selected_route.printer if selected_route else '' }}" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white font-mono focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition" />
        </div>

        <div>
          <label for="faxcatid" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Category') }}</label>
          <select name="faxcatid" id="faxcatid" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition">
            <option value="">{{ _('-- None --') }}</option>
            {% for cat in categories %}
              <option value="{{ cat.catid }}" {% if selected_route and selected_route.faxcatid == cat.catid %}selected{% endif %}>{{ cat.name }}</option>
            {% endfor %}
          </select>
        </div>

        <input type="hidden" name="_submit_check" value="1" />
        {% if selected_route %}
          <input type="hidden" name="didr_id" value="{{ selected_route.didr_id }}" />
        {% endif %}

        <div class="pt-3 border-t border-slate-800 flex items-center justify-end space-x-2">
          {% if selected_route %}
            <a href="/admin/routing/did" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg font-semibold text-xs transition">{{ _('Cancel') }}</a>
            <button type="submit" name="delete" value="1" onclick="return confirm('Are you sure you want to delete this DID route?');" class="px-4 py-2 bg-rose-900 hover:bg-rose-800 text-white rounded-lg font-bold text-xs transition">{{ _('Delete') }}</button>
            <button type="submit" name="save" value="1" class="px-6 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">{{ _('Save') }}</button>
          {% else %}
            <a href="/admin/routing/did" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg font-semibold text-xs transition">{{ _('Reset') }}</a>
            <button type="submit" name="create" value="1" class="px-6 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">{{ _('Save') }}</button>
          {% endif %}
        </div>
      </form>
    </div>

  </div>

  <!-- Bottom Hardware Diagnostic Note -->
  <div class="p-4 bg-slate-950/40 border border-slate-800/80 rounded-xl text-xs text-slate-400 leading-relaxed" id="explain-me">
    <p><strong class="text-slate-300">{{ _('Appliance Note:') }}</strong> {{ _('DID (Direct Inward Dialing) routing automatically redirects incoming transmissions matching extension patterns directly to mapped operator inboxes or physical printers.') }}</p>
  </div>

</div>
{% endblock %}
