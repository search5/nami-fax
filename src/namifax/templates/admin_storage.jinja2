{% extends "admin_layout.jinja2" %}

{% block title %}NamiFAX - Admin - Storage & Cloud{% endblock %}

{% block content %}
<div class="space-y-6">

  <!-- Header -->
  <div class="border-b border-slate-800 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center space-x-3">
      <div class="p-2 bg-blue-500/10 border border-blue-500/20 rounded-lg text-blue-400">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7M4 7c0-2 1.5-3 3.5-3h9c2 0 3.5 1 3.5 3M4 7h16m-8 4v4m-2-2h4" />
        </svg>
      </div>
      <div>
        <h1 class="text-xl font-bold text-slate-100">{{ _('Storage & Cloud') }}</h1>
        <p class="text-xs text-slate-400">{{ _('Enterprise storage lifecycle policies and S3 / MinIO cloud backends') }}</p>
      </div>
    </div>
  </div>

  <!-- Messages -->
  {% if message %}
  <div class="p-4 rounded-lg bg-emerald-950/40 border border-emerald-500/30 text-emerald-400 text-sm flex items-center gap-2">
    <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span>{{ message }}</span>
  </div>
  {% endif %}

  {% if error %}
  <div class="p-4 rounded-lg bg-rose-950/40 border border-rose-500/30 text-rose-400 text-sm flex items-center gap-2">
    <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <span>{{ error }}</span>
  </div>
  {% endif %}

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- Storage Lifecycle Policies -->
    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-4">
      <div class="border-b border-slate-800 pb-2 flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-200">{{ _('Storage Lifecycle Policies') }}</h2>
        <span class="text-xs text-blue-400 font-mono">Spec 40</span>
      </div>

      <form method="POST" action="/admin/storage" class="space-y-4">
        <input type="hidden" name="action" value="save_lifecycle">

        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">
            {{ _('Purge Local TIFFs After (Days)') }}
          </label>
          <input type="number" name="purge_tiff_after_days" value="{{ lifecycle.purge_tiff_after_days }}" min="0" max="3650"
                 class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
          <p class="text-xs text-slate-500 mt-1">{{ _('Frees local disk space if a PDF version exists. 0 = immediate after conversion.') }}</p>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">
            {{ _('Full Fax Retention (Days)') }}
          </label>
          <input type="number" name="full_retention_days" value="{{ lifecycle.full_retention_days }}" min="0" max="7300"
                 class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
          <p class="text-xs text-slate-500 mt-1">{{ _('Purge entire fax record and archival files after specified days. 0 = keep forever.') }}</p>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <input type="checkbox" id="remote_sync_delete" name="remote_sync_delete" value="1"
                 {% if lifecycle.remote_sync_delete %}checked{% endif %}
                 class="w-4 h-4 rounded bg-slate-950 border-slate-700 text-blue-600 focus:ring-0">
          <label for="remote_sync_delete" class="text-xs font-medium text-slate-300">
            {{ _('Synchronize remote cloud object deletion on fax purge') }}
          </label>
        </div>

        <div class="pt-2">
          <button type="submit" class="py-2 px-4 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition shadow-lg shadow-blue-500/20">
            {{ _('Save Lifecycle Policy') }}
          </button>
        </div>
      </form>
    </div>

    <!-- Cloud Storage Backend (S3 / MinIO) -->
    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-4">
      <div class="border-b border-slate-800 pb-2 flex items-center justify-between">
        <h2 class="text-base font-semibold text-slate-200">{{ _('Cloud Storage Backend') }}</h2>
        <span class="text-xs text-blue-400 font-mono">Spec 45</span>
      </div>

      <form method="POST" action="/admin/storage" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Storage Provider') }}</label>
          <select name="storage_type" data-provider-switch="cloud-fields" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
            <option value="LOCAL" {% if cloud.storage_type == 'LOCAL' %}selected{% endif %}>{{ _('Local Filesystem (Default)') }}</option>
            <option value="S3" {% if cloud.storage_type == 'S3' %}selected{% endif %}>Amazon S3 / MinIO / Ceph</option>
          </select>
        </div>

        <p id="cloud-note-LOCAL" class="{% if cloud.storage_type != 'LOCAL' %}hidden {% endif %}text-xs text-slate-500">{{ _('Faxes stay in the archive folder on this server. There is nothing to connect.') }}</p>

        <div id="cloud-fields" class="space-y-4{% if cloud.storage_type != 'S3' %} hidden{% endif %}">
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Endpoint URL (MinIO / S3 Compatible)') }}</label>
          <input type="text" name="endpoint_url" value="{{ cloud.endpoint_url }}" placeholder="https://s3.amazonaws.com or http://minio.internal:9000"
                 class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Region') }}</label>
            <input type="text" name="region_name" value="{{ cloud.region_name }}" placeholder="us-east-1"
                   class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Bucket Name') }}</label>
            <input type="text" name="bucket_name" value="{{ cloud.bucket_name }}" placeholder="namifax-archive"
                   class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Access Key ID') }}</label>
            <input type="text" name="access_key" value="{{ cloud.access_key }}" placeholder="AKIA..."
                   class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Secret Access Key') }}</label>
            <input type="password" name="secret_key" placeholder="{% if cloud.has_secret_key %}••••••••••••{% endif %}"
                   class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Key Prefix') }}</label>
          <input type="text" name="prefix" value="{{ cloud.prefix }}" placeholder="faxes/"
                 class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
        </div>

        </div>

        <div class="flex items-center gap-3 pt-2">
          <button type="submit" name="action" value="save_cloud" class="py-2 px-4 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition shadow-lg shadow-blue-500/20">
            {{ _('Save Storage Config') }}
          </button>
          <button id="cloud-test" type="submit" name="action" value="test_cloud" class="{% if cloud.storage_type != 'S3' %}hidden {% endif %}py-2 px-4 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-medium text-sm transition">
            {{ _('Test Connection') }}
          </button>
        </div>
      </form>
    </div>

  </div>

</div>
{% endblock %}

{% block extra_scripts %}<script src="/static/js/storage.js" defer></script>{% endblock %}
