{% extends "layout.jinja2" %}

{% block title %}NamiFAX - View Fax{% endblock %}

{% block content %}
<div class="max-w-6xl mx-auto space-y-4" id="viewer-container">

  <!-- Header: who, when, how many pages -->
  <div class="bg-white border border-slate-200/90 rounded-xl p-4 shadow-xs space-y-1">
    <h2 class="text-base font-bold text-slate-900 tracking-tight">
      {{ _('From') }}:
      {% if choices %}
        <form action="/setcompany" method="post" class="inline-flex gap-1 align-middle">
          <select name="faxnumid" class="border border-slate-300 rounded px-2 py-1 text-xs">{% for c in choices %}<option value="{{ c.abookfax_id }}">{{ c.company }}</option>{% endfor %}</select>
          <input type="hidden" name="fid" value="{{ fid }}" /><input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
          <button type="submit" class="px-2 py-1 bg-slate-100 rounded text-xs">{{ _('Select') }}</button>
        </form>
      {% elif assign == 'x' %}<a href="/assignx?fid={{ fid }}" class="text-sky-700 hover:underline" title="{{ _('Assign a company name') }}">{{ company or origfaxnum or '-' }}</a>
      {% elif assign == 'c' %}<a href="/assign?cid={{ cid }}" class="text-sky-700 hover:underline" title="{{ _('Assign a company name') }}">{{ company }}</a>
      {% elif cid %}<a href="/addressbook?abook_id={{ cid }}" class="text-sky-700 hover:underline">{{ company }}</a>
      {% else %}{{ company or origfaxnum or '-' }}{% endif %}
    </h2>
    <div class="text-xs text-slate-600 flex flex-wrap gap-x-5 gap-y-1">
      <span>{{ _('Date') }}: <strong>{{ archstamp or '-' }}</strong></span>
      <span>{{ _('Pages') }}: <strong>{{ pages }}</strong></span>
      <span>FaxID: <strong>{{ fid }}</strong></span>
      {% if modemdev %}<span>{{ _('Device') }}: <strong>{{ modemdev }}</strong></span>{% endif %}
    </div>
  </div>

  <!-- Actions -->
  <div id="sidemenu" class="flex items-center gap-1.5 flex-wrap">
    {% if prev_fid %}<a href="/viewfax?fid={{ prev_fid }}" title="{{ _('Previous fax') }}" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition inline-flex items-center">&larr; {{ _('Prev') }}</a>{% endif %}
    {% if next_fid %}<a href="/viewfax?fid={{ next_fid }}" title="{{ _('Next fax') }}" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition inline-flex items-center">{{ _('Next') }} &rarr;</a>{% endif %}
    <form method="post" action="/faxes/rotate/{{ fid }}" class="inline">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
      <input type="hidden" name="redirect" value="viewfax" />
      <button type="submit" title="{{ _('Rotate fax') }}" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition inline-flex items-center">{{ _('Rotate') }}</button>
    </form>
    <a href="/faxes/download/{{ fid }}?format=pdf" title="{{ _('Download PDF') }}" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition inline-flex items-center">PDF</a>
    {% if dl_tiff_enabled %}
    <a href="/faxes/download/{{ fid }}?format=tiff" title="{{ _('Download TIFF') }}" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition inline-flex items-center">TIFF</a>
    {% endif %}
    <a href="/refax?fid={{ fid }}" title="{{ _('Reply to fax') }}" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition inline-flex items-center">{{ _('Reply') }}</a>
    <a href="/email?fid={{ fid }}" title="{{ _('Email PDF') }}" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition inline-flex items-center">{{ _('Email') }}</a>
    <a href="/note?fid={{ fid }}" title="{{ _('Add note to fax') }}" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition inline-flex items-center">{{ _('Note') }}</a>
    <form method="post" action="/ajax/archivefax" class="inline">
      <input type="hidden" name="_submit_check" value="1" />
      <input type="hidden" name="fids" value="{{ fid }}" />
      <input type="hidden" name="next" value="{{ after }}" />
      <button type="submit" title="{{ _('Archive fax') }}" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 transition inline-flex items-center">{{ _('Archive') }}</button>
    </form>
    {% if can_del %}<a href="/delete?fid={{ fid }}&amp;next={{ after }}" title="{{ _('Delete fax') }}" class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-rose-200 bg-white hover:bg-rose-50 text-rose-700 transition">{{ _('Delete') }}</a>{% endif %}
    <a href="/inbox" class="px-3.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-xs font-bold transition ml-auto">{{ _('Inbox') }} &rarr;</a>
  </div>

  <!-- Pages: thumbnails and the big image -->
  <div class="grid grid-cols-1 md:grid-cols-6 gap-6">
    <div id="faxesmenu" class="md:col-span-1 bg-white border border-slate-200/90 rounded-xl p-3 shadow-xs space-y-3 max-h-[760px] overflow-y-auto">
      {% for p in range(1, pages + 1) %}
      <div id="thumb_{{ p }}" class="text-center">
        <span class="block text-[11px] font-bold text-slate-700 mb-1">{{ p }}</span>
        <img src="/faxes/image/{{ fid }}/{{ p }}" width="80" alt="" title="{{ _('Page') }} {{ p }}" data-page="{{ p }}"
             class="mx-auto border border-dashed border-amber-300 cursor-pointer" loading="lazy" />
      </div>
      {% endfor %}
    </div>

    <div id="viewfaximage" class="md:col-span-5 bg-slate-900 rounded-xl border border-slate-800 p-4 flex justify-center">
      <img id="viewimage" src="/faxes/image/{{ fid }}/1" title="{{ _('Page') }} 1" class="max-w-full h-auto bg-white shadow-2xl" alt="{{ _('Page') }} 1" />
    </div>
  </div>
</div>

<script>
// A click on a thumbnail shows that page; a click on the page shows the next one (the original's showNextImage()).
(function () {
  var main = document.getElementById('viewimage'), pages = {{ pages }}, current = 1;
  function show(n) { current = n; main.src = '/faxes/image/{{ fid }}/' + n; main.alt = main.title = '{{ _('Page') }} ' + n; }
  document.querySelectorAll('#faxesmenu img').forEach(function (img) {
    img.addEventListener('click', function () { show(parseInt(img.getAttribute('data-page'), 10)); });
  });
  main.addEventListener('click', function () { show(current < pages ? current + 1 : 1); });
})();
</script>
{% endblock %}
