<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900/50 backdrop-blur-xs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>- NamiFAX - Send Fax via Email</title>
  <link rel="icon" href="/static/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/static/css/main.css?v=3.6.0" type="text/css" />
</head>
<body class="min-h-full flex items-center justify-center p-4 sm:p-6 font-sans antialiased text-slate-800">

  <div class="w-full max-w-lg bg-white rounded-2xl shadow-2xl border border-slate-200/90 overflow-hidden">
    
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/70">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-lg bg-sky-50 border border-sky-200 flex items-center justify-center text-sky-700 shadow-2xs">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h1 class="text-sm font-bold text-slate-900 tracking-tight">{{ _('Forward fax via email') }}</h1>
          <p class="text-[11px] text-slate-500">{{ _('Dispatch PDF document attachment to email recipients') }}</p>
        </div>
      </div>
      <button type="button" onclick="window.close()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-100 transition">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    {% if message %}
    <div class="p-6 text-center space-y-4 text-xs">
      <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-700">{{ message }}</div>
      <a href="{{ values.url }}" class="inline-block px-5 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold transition">{{ _('Back') }}</a>
    </div>
    {% else %}
    <form action="/email" method="post" class="p-6 space-y-4 text-xs">
      {% if error %}<div class="p-3 bg-rose-50 border border-rose-200 rounded-lg text-rose-700">{{ error }}</div>{% endif %}
      <div>
        <span class="block font-semibold text-slate-700 mb-1.5">{{ _('From') }}</span>
        <div class="text-slate-600">{{ from_display }}</div>
      </div>
      <div>
        <label for="emails" class="block font-semibold text-slate-700 mb-1.5">{{ _('Recipients') }} *
          <a href="/helper/emailcontacts?target=emails" onclick="window.open(this.href, 'picker', 'width=520,height=560'); return false;" class="ml-2 font-normal text-sky-700 hover:underline">{{ _('Choose from contacts') }}</a>
        </label>
        <textarea name="emails" id="emails" rows="3" required class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">{{ values.emails }}</textarea>
      </div>
      <div>
        <label for="cc_emails" class="block font-semibold text-slate-700 mb-1.5">{{ _('CC') }}</label>
        <textarea name="cc_emails" id="cc_emails" rows="2" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">{{ values.cc_emails }}</textarea>
      </div>
      <div>
        <label for="bcc_emails" class="block font-semibold text-slate-700 mb-1.5">{{ _('BCC') }}</label>
        <textarea name="bcc_emails" id="bcc_emails" rows="2" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">{{ values.bcc_emails }}</textarea>
      </div>
      <div>
        <label for="subject" class="block font-semibold text-slate-700 mb-1.5">{{ _('Subject') }}</label>
        <input type="text" name="subject" id="subject" value="{{ values.subject }}" maxlength="45" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" />
      </div>
      <div>
        <label for="filename" class="block font-semibold text-slate-700 mb-1.5">{{ _('PDF file name') }}</label>
        <input type="text" name="filename" id="filename" value="{{ values.filename }}" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" />
      </div>
      <div>
        <label for="msg" class="block font-semibold text-slate-700 mb-1.5">{{ _('Message') }}</label>
        <textarea name="msg" id="msg" rows="8" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">{{ values.msg }}</textarea>
      </div>
      {% if in_inbox %}
      <div>
        <label for="category" class="block font-semibold text-slate-700 mb-1.5">{{ _('Category') }}</label>
        <select name="category" id="category" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">
          <option value=""></option>
          {% for cid, cname in categories.items() %}<option value="{{ cid }}" {% if values.category == cid %}selected{% endif %}>{{ cname }}</option>{% endfor %}
        </select>
      </div>
      <label class="inline-flex items-center gap-2"><input type="checkbox" name="archive" id="archive" value="1" {% if values.archive %}checked{% endif %} /> {{ _('Archive fax') }}</label>
      {% endif %}

      <input type="hidden" name="fid" value="{{ values.fid }}" />
      <input type="hidden" name="url" value="{{ values.url }}" />
      <input type="hidden" name="_submit_check" value="1" />

      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-2.5">
        <a href="{{ values.url }}" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-semibold text-xs transition">{{ _('Cancel') }}</a>
        <button type="submit" class="px-5 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">{{ _('Send') }}</button>
      </div>
    </form>
    {% endif %}

  </div>

</body>
</html>

