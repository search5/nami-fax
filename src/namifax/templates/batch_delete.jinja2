<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900/50 backdrop-blur-xs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="icon" href="/static/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/static/css/main.css?v=3.6.0" type="text/css" />
</head>
<body class="min-h-full flex items-center justify-center p-4 font-sans antialiased text-slate-800">
  <div class="w-full max-w-sm bg-white rounded-2xl shadow-2xl border border-slate-200 p-6 text-center">
    <h1 class="text-sm font-bold text-slate-900">{{ _('Delete selected faxes?') }}</h1>
    <p class="text-xs text-slate-500 mt-1">{{ fids|length }} {{ _('faxes') }}</p>
    <form action="/ajax/deletefaxes" method="post" class="mt-5 flex justify-center gap-2 text-xs">
      {% for fid in fids %}<input type="hidden" name="fids" value="{{ fid }}" />{% endfor %}
      <input type="hidden" name="_submit_check" value="1" />
      <a href="/inbox" class="px-4 py-2 bg-white hover:bg-slate-50 text-slate-700 rounded-lg font-semibold border border-slate-300 transition">{{ _('Cancel') }}</a>
      <button type="submit" class="px-5 py-2 bg-rose-700 hover:bg-rose-600 text-white rounded-lg font-semibold transition">{{ _('Delete') }}</button>
    </form>
  </div>
</body>
</html>
