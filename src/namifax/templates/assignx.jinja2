<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900/50 backdrop-blur-xs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="icon" href="/static/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/static/css/main.css?v=3.6.0" type="text/css" />
</head>
<body class="min-h-full flex items-center justify-center p-4 sm:p-6 font-sans antialiased text-slate-800">
  <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl border border-slate-200/90 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/70">
      <h1 class="text-sm font-bold text-slate-900 tracking-tight">{{ _('Name the sender') }}</h1>
      {% if origfaxnum %}<p class="text-[11px] text-slate-500 font-mono">{{ origfaxnum }}</p>{% endif %}
    </div>

    <form action="/assignx" method="post" class="p-6 space-y-4 text-xs">
      {% if error %}<div class="p-3 bg-rose-50 border border-rose-200 rounded-lg text-rose-700">{{ error }}</div>{% endif %}

      <div>
        <label for="abook_id" class="block font-semibold text-slate-700 mb-1.5">{{ _('Select Contact Record') }}</label>
        <select name="abook_id" id="abook_id" size="6" class="w-full border border-slate-300 rounded-lg p-2 bg-slate-50/50 text-slate-900 font-medium focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition">
          <option value=""></option>
          {% for cid, name in companies %}<option value="{{ cid }}">{{ name }}</option>{% endfor %}
        </select>
      </div>

      <div>
        <label for="regexp" class="block font-semibold text-slate-700 mb-1.5">{{ _('Or type a new company name') }}</label>
        <input type="text" name="regexp" id="regexp" class="w-full border border-slate-300 rounded-lg px-3.5 py-2 bg-slate-50/50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 transition" />
      </div>

      <input type="hidden" name="fid" value="{{ fid }}" />
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
      <input type="hidden" name="_submit_check" value="1" />

      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-2.5">
        <a href="/inbox" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-semibold text-xs transition">{{ _('Cancel') }}</a>
        <button type="submit" class="px-5 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">{{ _('Save') }}</button>
      </div>
    </form>
  </div>
</body>
</html>
