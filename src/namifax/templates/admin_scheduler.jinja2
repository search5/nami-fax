{% extends "admin_layout.jinja2" %}

{% block title %}NamiFAX - Admin - Scheduled Tasks{% endblock %}

{% block content %}
<div class="space-y-6">
  <div class="border-b border-slate-800 pb-4">
    <h1 class="text-xl font-bold text-slate-100">{{ _('Scheduled Tasks') }}</h1>
    <p class="text-xs text-slate-400">{{ _('Housekeeping that runs by itself: temporary files, moving old faxes to the archive, the retention policy and the phonebook export.') }}</p>
  </div>

  {% if message %}<div class="p-4 rounded-lg bg-emerald-950/40 border border-emerald-500/30 text-emerald-400 text-sm">{{ message }}</div>{% endif %}
  {% if error %}<div class="p-4 rounded-lg bg-rose-950/40 border border-rose-500/30 text-rose-400 text-sm">{{ error }}</div>{% endif %}

  <div id="scheduler-state" data-state-url="/admin/scheduler/state">{{ state_html|safe }}</div>

  <form id="settings" method="post" action="/admin/scheduler"></form>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-3" id="job-tmp">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <input type="checkbox" id="tmp_enabled" name="tmp_enabled" value="1" {% if s.tmp_enabled %}checked{% endif %} form="settings"
                 class="w-4 h-4 rounded bg-slate-900 border-slate-700 text-blue-600 focus:ring-0">
          <div>
            <label for="tmp_enabled" class="text-sm font-semibold text-slate-100 cursor-pointer">{{ _('Clean the temporary folder') }}</label>
            <p class="text-xs text-slate-400">{{ _('Delete temporary files older than the days given, every day at the time given.') }}</p>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><div><label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Time (HH:MM)') }}</label><input type="text" name="tmp_time" value="{{ s.tmp_time }}" form="settings" maxlength="5" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500"></div><div><label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Older than (days)') }}</label><input type="number" name="tmp_days" value="{{ s.tmp_days }}" form="settings" min="1" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500"></div></div>
      {{ job_html['tmp']|safe }}
    </div>
    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-3" id="job-inbox">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <input type="checkbox" id="inbox_enabled" name="inbox_enabled" value="1" {% if s.inbox_enabled %}checked{% endif %} form="settings"
                 class="w-4 h-4 rounded bg-slate-900 border-slate-700 text-blue-600 focus:ring-0">
          <div>
            <label for="inbox_enabled" class="text-sm font-semibold text-slate-100 cursor-pointer">{{ _('Move old faxes to the archive') }}</label>
            <p class="text-xs text-slate-400">{{ _('Faxes in the inbox older than the days given go to the archive (nothing is deleted).') }}</p>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><div><label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Time (HH:MM)') }}</label><input type="text" name="inbox_time" value="{{ s.inbox_time }}" form="settings" maxlength="5" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500"></div><div><label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Older than (days)') }}</label><input type="number" name="inbox_days" value="{{ s.inbox_days }}" form="settings" min="1" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500"></div></div>
      {{ job_html['inbox']|safe }}
    </div>
    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-3" id="job-lifecycle">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <input type="checkbox" id="lifecycle_enabled" name="lifecycle_enabled" value="1" {% if s.lifecycle_enabled %}checked{% endif %} form="settings"
                 class="w-4 h-4 rounded bg-slate-900 border-slate-700 text-blue-600 focus:ring-0">
          <div>
            <label for="lifecycle_enabled" class="text-sm font-semibold text-slate-100 cursor-pointer">{{ _('Apply the retention policy') }}</label>
            <p class="text-xs text-slate-400">{{ _('Runs the TIFF purge and the retention period saved on the Storage page. Nothing is removed until a policy has been saved there.') }}</p>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><div><label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Time (HH:MM)') }}</label><input type="text" name="lifecycle_time" value="{{ s.lifecycle_time }}" form="settings" maxlength="5" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500"></div><div class="text-xs text-slate-400 self-end">{% if policy.tiff_days or policy.keep_days %}{{ _('Saved policy') }}: TIFF {{ policy.tiff_days or '-' }} / {{ _('keep') }} {{ policy.keep_days or '-' }} {{ _('days') }}{% else %}{{ _('No policy saved yet') }}{% endif %} &mdash; <a href="/admin/storage" class="text-blue-400 hover:underline">{{ _('Storage & Cloud') }}</a></div></div>
      {{ job_html['lifecycle']|safe }}
    </div>
    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-3" id="job-phonebook">
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <input type="checkbox" id="phonebook_enabled" name="phonebook_enabled" value="1" {% if s.phonebook_enabled %}checked{% endif %} form="settings"
                 class="w-4 h-4 rounded bg-slate-900 border-slate-700 text-blue-600 focus:ring-0">
          <div>
            <label for="phonebook_enabled" class="text-sm font-semibold text-slate-100 cursor-pointer">{{ _('Export the address book to HylaFAX') }}</label>
            <p class="text-xs text-slate-400">{{ _('Writes the address book as a HylaFAX phonebook, repeatedly.') }}</p>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><div><label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Every (minutes)') }}</label><input type="number" name="phonebook_minutes" value="{{ s.phonebook_minutes }}" form="settings" min="1" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500"></div></div>
      {{ job_html['phonebook']|safe }}
    </div>
  </div>

  <div><button type="submit" form="settings" class="py-2 px-5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition">{{ _('Save') }}</button></div>
</div>
{% endblock %}

{% block extra_scripts %}<script src="/static/js/scheduler.js" defer></script>{% endblock %}
