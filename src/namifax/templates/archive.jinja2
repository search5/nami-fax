{% extends "layout.jinja2" %}

{% block title %}NamiFAX — Archive{% endblock %}

{% macro choose(name, options, selected, id=None, cls='') %}
<select name="{{ name }}" id="{{ id or name }}" class="border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm {{ cls }}">
  {% for value, label in options %}<option value="{{ value }}" {% if value|string == selected|string %}selected{% endif %}>{{ label }}</option>{% endfor %}
</select>
{% endmacro %}

{% block content %}
<div class="space-y-5">
  <span class="sr-only">Archive Search Categories Results</span>

  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-slate-900">{{ _('Archive Search') }}</h1>
      <p class="text-sm text-slate-500 mt-0.5">{{ _('Search all sent and received fax records by date, company, or fax number.') }}</p>
    </div>
  </div>

  <form action="/archive" method="get" class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/60">
      <h2 class="text-sm font-semibold text-slate-900">{{ _('Search Filters') }}</h2>
      <p class="text-xs text-slate-400 mt-0.5">{{ _('Leave filters empty to search all records. Narrow results by adding more criteria.') }}</p>
    </div>

    <div class="p-5 grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="space-y-4">
        <div>
          <label for="regexp" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Company search') }}</label>
          <input type="text" name="regexp" id="regexp" value="{{ form.regexp }}" autocomplete="off"
                 class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm" />
        </div>
        <div>
          <label for="companyid" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Company list') }}</label>
          <select name="companyid" id="companyid" size="5" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm bg-white shadow-sm">
            <option value=""></option>
            {% for value, label in companies %}<option value="{{ value }}" {% if value == form.companyid|string %}selected{% endif %}>{{ label }}</option>{% endfor %}
          </select>
        </div>
        <div>
          <label for="faxid" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Fax ID') }}</label>
          <input type="text" name="faxid" id="faxid" value="{{ form.faxid }}" placeholder="{{ _('e.g. 104') }}"
                 class="w-32 border border-slate-300 rounded-lg px-4 py-2.5 text-sm font-mono text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm" />
        </div>
      </div>

      <div class="space-y-4">
        <div>
          <label for="kw" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Keywords') }}</label>
          <input type="text" name="kw" id="kw" value="{{ form.kw }}" placeholder="{{ _('Company, number, notes...') }}"
                 class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-sm" />
        </div>
        <div>
          <label for="category" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Categories') }}</label>
          {{ choose('category', [('', _('All Categories'))] + category_list, form.category, cls='w-full') }}
        </div>
        {% if superuser %}
        <div>
          <label for="userid" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('User') }}</label>
          {{ choose('userid', user_list, form.userid, cls='w-full') }}
        </div>
        {% endif %}
        <div>
          <span class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Start Date') }}</span>
          <div class="flex gap-2">
            {{ choose('start_day', days, form.start_day) }}{{ choose('start_month', months, form.start_month) }}{{ choose('start_year', years, form.start_year) }}
          </div>
        </div>
        <div>
          <span class="block text-sm font-semibold text-slate-800 mb-1">{{ _('End Date') }}</span>
          <div class="flex gap-2">
            {{ choose('end_day', days, form.end_day) }}{{ choose('end_month', months, form.end_month) }}{{ choose('end_year', years, form.end_year) }}
          </div>
        </div>
        <div>
          <label for="sentrecvd" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Direction') }}</label>
          {{ choose('sentrecvd', sentrecvd_list, form.sentrecvd, cls='w-full') }}
        </div>
      </div>
    </div>

    <div class="px-5 py-4 border-t border-slate-100 flex items-center justify-end gap-2">
      <a href="/archive" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-semibold transition-colors">{{ _('Reset') }}</a>
      <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-bold shadow-sm transition-colors">{{ _('Search') }}</button>
    </div>
  </form>

  <!-- Results -->
  <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-slate-100 bg-slate-50/60 text-sm text-slate-700">
      {% if total %}{{ _('Total %(n)d results found.') % {'n': total} }}{% if pages %} &nbsp;{{ first_shown }} - {{ last_shown }}{% endif %}{% endif %}
    </div>
    {% if rows %}
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-slate-100 bg-slate-50/80">
            <th class="py-3 px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">#</th>
            <th class="py-3 px-2"></th>
            <th class="py-3 px-3"></th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Company') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Description') }}</th>
            <th class="py-3 px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider text-center">{{ _('Pages') }}</th>
            <th class="py-3 px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Category') }}</th>
            <th class="py-3 px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('Date') }}</th>
            {% if superuser %}<th class="py-3 px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">{{ _('User') }}</th>{% endif %}
            <th class="py-3 px-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {% for r in rows %}
          <tr class="hover:bg-slate-50 transition-colors" id="faxid_{{ r.id }}" data-preview="/faxes/thumbnail/{{ r.id }}">
            <td class="archive-results py-3 px-3 text-sm text-slate-500">{{ start_number + loop.index0 }}</td>
            <td class="py-3 px-2"><img src="/faxes/thumbnail/{{ r.id }}" alt="" loading="lazy" class="w-10 h-14 object-cover border border-slate-200 rounded" /></td>
            <td class="py-3 px-3 whitespace-nowrap text-xs">
              <a href="/faxes/download/{{ r.id }}?format=pdf" class="px-1.5 py-1 rounded border border-slate-200 text-slate-700 hover:bg-slate-50" title="{{ _('Download PDF') }}">PDF</a>
              <a href="/refax?fid={{ r.id }}" class="px-1.5 py-1 rounded border border-slate-200 text-slate-700 hover:bg-slate-50" title="{{ _('Reply to fax') }}">{{ _('Re-send') }}</a>
              <a href="/email?fid={{ r.id }}" class="px-1.5 py-1 rounded border border-slate-200 text-slate-700 hover:bg-slate-50" title="{{ _('Email PDF') }}">{{ _('Email') }}</a>
              <a href="/note?fid={{ r.id }}" class="px-1.5 py-1 rounded border border-slate-200 text-slate-700 hover:bg-slate-50" title="{{ _('Add note to fax') }}">{{ _('Note') }}</a>
              {% if can_del %}<a href="/delete?fid={{ r.id }}" class="px-1.5 py-1 rounded border border-rose-200 text-rose-700 hover:bg-rose-50" title="{{ _('Delete fax') }}">{{ _('Delete') }}</a>{% endif %}
            </td>
            <td class="archive-company py-3 px-4 text-sm">
              {% if r.choices %}
                <form action="/setcompany" method="post" class="flex gap-1">
                  <select name="faxnumid" class="border border-slate-300 rounded px-2 py-1 text-xs">{% for c in r.choices %}<option value="{{ c.abookfax_id }}">{{ c.company }}</option>{% endfor %}</select>
                  <input type="hidden" name="fid" value="{{ r.id }}" /><input type="hidden" name="csrf_token" value="{{ request.session.get_csrf_token() }}" />
                  <button type="submit" class="px-2 py-1 bg-slate-100 rounded text-xs">{{ _('Select') }}</button>
                </form>
              {% elif r.assign == 'x' %}
                <a href="/assignx?fid={{ r.id }}" class="text-blue-700 hover:underline" title="{{ _('Assign a company name') }}">{{ r.company or r.origfaxnum or _('Unknown') }}</a>
              {% elif r.assign == 'c' %}
                <a href="/assign?cid={{ r.cid }}" class="text-blue-700 hover:underline" title="{{ _('Assign a company name') }}">{{ r.company }}</a>
              {% elif r.cid %}
                <a href="/addressbook?abook_id={{ r.cid }}" class="font-semibold text-slate-900 hover:text-blue-700 hover:underline">{{ r.company }}</a>
              {% else %}{{ r.company or r.origfaxnum }}{% endif %}
              {% if r.origfaxnum %}<div class="text-xs text-slate-400 font-mono">{{ r.origfaxnum }}</div>{% endif %}
            </td>
            <td class="archive-description py-3 px-4 text-sm text-slate-600">{{ r.description }}</td>
            <td class="archive-results py-3 px-3 text-center text-sm">{{ r.pages }}</td>
            <td class="archive-results py-3 px-3 text-sm">{{ r.category }}</td>
            <td class="archive-results py-3 px-4 text-xs font-mono whitespace-nowrap text-slate-600">{{ r.archstamp }}</td>
            {% if superuser %}<td class="archive-results py-3 px-3 text-sm">{{ r.user }}</td>{% endif %}
            <td class="py-3 px-3 text-center">
              <a href="/txreport?fid={{ r.id }}" class="text-xs px-2 py-1 rounded-full {{ 'bg-emerald-50 text-emerald-700' if r.received else 'bg-sky-50 text-sky-700' }}"
                 title="FaxID: {{ r.id }}{% if r.modemdev %} [{{ r.modemdev }}]{% endif %}">{{ _('Received') if r.received else _('Sent') }}</a>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}
    <div class="p-10 text-center">
      <h3 class="text-base font-bold text-slate-800">{{ _('No results were found') }}</h3>
      <a href="/archive" class="mt-3 inline-block text-sm text-blue-600 hover:underline font-medium">{{ _('Reset filters') }}</a>
    </div>
    {% endif %}
  </div>

  {% if pages %}
  <nav class="paging flex items-center justify-center gap-1" aria-label="{{ _('Pages') }}">
    {% if page > 0 %}<a href="{{ links[page - 1] }}" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100" title="{{ _('Previous') }}">&lsaquo;</a>{% endif %}
    {% for p in range(pages) %}
      {% if p == page %}<span class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-bold bg-blue-600 text-white">{{ p + 1 }}</span>
      {% else %}<a href="{{ links[p] }}" class="w-8 h-8 flex items-center justify-center rounded-lg text-sm text-slate-600 hover:bg-slate-100">{{ p + 1 }}</a>{% endif %}
    {% endfor %}
    {% if page < pages - 1 %}<a href="{{ links[page + 1] }}" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100" title="{{ _('Next') }}">&rsaquo;</a>{% endif %}
  </nav>
  {% endif %}
</div>

<script>
// The company list follows what is typed in the company search (the original's CompanyList filter).
(function () {
  var box = document.getElementById('regexp'), list = document.getElementById('companyid'), timer = null;
  if (!box || !list || !window.fetch) return;
  box.addEventListener('keyup', function () {
    clearTimeout(timer);
    timer = setTimeout(function () {
      fetch('/ajax/archivebook?q=' + encodeURIComponent(box.value)).then(function (r) { return r.text(); }).then(function (text) {
        var rows = new DOMParser().parseFromString(text, 'text/xml').getElementsByTagName('row');
        list.innerHTML = '<option value=""></option>';
        for (var i = 0; i < rows.length; i++) {
          var o = document.createElement('option');
          o.value = rows[i].getElementsByTagName('cid')[0].textContent;
          o.textContent = rows[i].getElementsByTagName('company')[0].textContent;
          list.appendChild(o);
        }
      });
    }, 250);
  });
})();
</script>
<div id="faxpreview" class="hidden absolute z-50 w-32 h-48 border-2 border-orange-500 bg-white p-0.5 pointer-events-none">
  <img src="data:," alt="" class="w-full h-full object-contain" />
</div>
<script src="/static/js/archive.js" defer></script>
{% endblock %}
