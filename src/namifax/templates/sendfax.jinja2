{% extends "layout.jinja2" %}

{% block title %}NamiFAX — Send Fax{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto space-y-5">

  <!-- Page Header -->
  <div class="flex items-start justify-between">
    <div>
      <h1 class="text-xl font-bold text-slate-900">{{ _('Send Fax') }}</h1>
      <p class="text-sm text-slate-500 mt-0.5">{{ _('Fill in the details below and click Send.') }}</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/addressbook" class="inline-flex items-center gap-1.5 px-3 py-2 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 rounded-lg text-sm font-medium transition-colors">
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
        {{ _('Address Book') }}
      </a>
      <a href="/distrolist" class="inline-flex items-center gap-1.5 px-3 py-2 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 rounded-lg text-sm font-medium transition-colors">
        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
        {{ _('Distribution Lists') }}
      </a>
    </div>
  </div>

  {% if error %}
  <div class="p-4 bg-red-50 border border-red-200 text-red-800 rounded-xl text-sm flex items-start gap-3">
    <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    <span>{{ error }}</span>
  </div>
  {% endif %}

  <form action="/sendfax" method="post" enctype="multipart/form-data" class="space-y-4">

    <!-- 1. Destination -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/60 flex items-center gap-2">
        <span class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0">1</span>
        <div>
          <h2 class="text-sm font-semibold text-slate-900">{{ _('Destination & Recipients') }}</h2>
          <p class="text-xs text-slate-400">{{ _('Enter the fax number and recipient details.') }}</p>
        </div>
      </div>

      <div class="p-5 space-y-4">
        <div>
          <label for="faxnumber" class="block text-sm font-semibold text-slate-800 mb-1">
            {{ _('Destination fax numbers') }} <span class="text-red-500">*</span>
          </label>
          <input type="text" name="faxnumber" id="faxnumber"
                 value="{{ form_data.faxnumber or form_data.destinations or '' }}"
                 required autofocus
                 placeholder="{{ _('e.g. +1-555-0199  —  separate multiple numbers with semicolons') }}"
                 class="w-full border border-slate-300 rounded-lg px-4 py-3 text-sm font-mono text-slate-900 bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
          <p class="text-xs mt-1.5 flex gap-3">
            <a href="/helper/faxcontacts?target=faxnumber" onclick="window.open(this.href, 'picker', 'width=520,height=560'); return false;" class="text-blue-600 hover:underline">{{ _('Choose from contacts') }}</a>
            <a href="/helper/distrocontacts?target=faxnumber" onclick="window.open(this.href, 'picker', 'width=520,height=560'); return false;" class="text-blue-600 hover:underline">{{ _('Choose a distribution list') }}</a>
          </p>
          <p class="text-xs text-slate-400 mt-1.5">
            💡 {{ _('To send to multiple recipients at once, separate numbers with a semicolon.') }}
            {{ _('Saved contacts are available in the') }} <a href="/addressbook" class="text-blue-600 hover:underline">{{ _('Address Book') }}</a>.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="to_person" class="block text-sm font-semibold text-slate-800 mb-1">
              {{ _('Attention To') }} <span class="text-xs font-normal text-slate-400">{{ _('optional') }}</span>
            </label>
            <input type="text" name="to_person" id="to_person"
                   value="{{ form_data.to_person or '' }}"
                   placeholder="{{ _('e.g. Jane Doe') }}"
                   class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white
                          focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
          </div>
          <div>
            <label for="to_company" class="block text-sm font-semibold text-slate-800 mb-1">
              {{ _('Company') }} <span class="text-xs font-normal text-slate-400">{{ _('optional') }}</span>
            </label>
            <input type="text" name="to_company" id="to_company"
                   value="{{ form_data.to_company or '' }}"
                   placeholder="{{ _('e.g. Acme Corporation') }}"
                   class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white
                          focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="to_location" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Location') }} <span class="text-xs font-normal text-slate-400">{{ _('optional') }}</span></label>
            <input type="text" name="to_location" id="to_location" value="{{ form_data.to_location or '' }}" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
          </div>
          <div>
            <label for="to_voicenumber" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Voice Number') }} <span class="text-xs font-normal text-slate-400">{{ _('optional') }}</span></label>
            <input type="text" name="to_voicenumber" id="to_voicenumber" value="{{ form_data.to_voicenumber or '' }}" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
          </div>
          <div>
            <label for="to_address" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Address') }} <span class="text-xs font-normal text-slate-400">{{ _('optional') }}</span></label>
            <input type="text" name="to_address" id="to_address" value="{{ form_data.to_address or '' }}" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
          </div>
          <div>
            <label for="to_city" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('City') }} <span class="text-xs font-normal text-slate-400">{{ _('optional') }}</span></label>
            <input type="text" name="to_city" id="to_city" value="{{ form_data.to_city or '' }}" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
          </div>
          <div>
            <label for="to_zip" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Zip') }} <span class="text-xs font-normal text-slate-400">{{ _('optional') }}</span></label>
            <input type="text" name="to_zip" id="to_zip" value="{{ form_data.to_zip or '' }}" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
          </div>
        </div>

        <div>
          <label for="regarding" class="block text-sm font-semibold text-slate-800 mb-1">
            {{ _('Subject / Regarding') }} <span class="text-xs font-normal text-slate-400">{{ _('optional') }}</span>
          </label>
          <input type="text" name="regarding" id="regarding"
                 value="{{ form_data.regarding or '' }}"
                 placeholder="{{ _('e.g. Purchase Order #4921') }}"
                 class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
        </div>
      </div>
    </div>

    <!-- 2. Document Attachment -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/60 flex items-center gap-2">
        <span class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0">2</span>
        <div>
          <h2 class="text-sm font-semibold text-slate-900">{{ _('Document Attachment') }}</h2>
          <p class="text-xs text-slate-400">{{ _('Attach the file you want to transmit.') }}</p>
        </div>
      </div>

      <div class="p-5">
        <label for="file"
               class="flex flex-col items-center justify-center w-full border-2 border-dashed border-slate-300 hover:border-blue-400 rounded-xl p-8 text-center cursor-pointer group transition-colors bg-slate-50 hover:bg-blue-50/20">
          <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 group-hover:border-blue-300 flex items-center justify-center mb-3 shadow-sm transition-colors">
            <svg class="w-6 h-6 text-slate-400 group-hover:text-blue-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
            </svg>
          </div>
          <p class="text-sm font-semibold text-slate-700 group-hover:text-blue-700 transition-colors" id="file-label">{{ _('Click to select a file') }}</p>
          <p class="text-xs text-slate-400 mt-1">{{ _('Supported: PDF, TIFF, PostScript, TXT') }} · {{ _('Max') }} {{ max_upload }}</p>
          <input type="file" name="file" id="file" multiple class="sr-only" accept=".pdf,.tif,.tiff,.ps,.txt" data-list="files_list" data-max-bytes="{{ max_upload_bytes }}" />
        <div id="files_list" class="mt-3 space-y-1 text-left w-full"></div>
        </label>
        <p class="text-xs text-slate-400 mt-2">
          💡 {{ _('PDF is the most commonly used format. Convert Word or Excel files to PDF before attaching.') }}
        </p>
      </div>
    </div>

    <!-- 3. Cover Page -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-100 bg-slate-50/60 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0">3</span>
          <div>
            <h2 class="text-sm font-semibold text-slate-900">{{ _('Cover Page') }}</h2>
            <p class="text-xs text-slate-400">{{ _('Add a cover sheet with sender and recipient info.') }}</p>
          </div>
        </div>
        <label class="inline-flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="coverpage" id="coverpage" value="1" data-folds="coverpagediv"
                 {% if form_data.coverpage %}checked{% endif %}
                 class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
          <span class="text-sm text-slate-700">{{ _('Include Cover Page') }}</span>
        </label>
      </div>

      <div id="coverpagediv"{% if not form_data.coverpage %} class="hidden"{% endif %}>
      <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="whichcover" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Cover Template') }}</label>
          <select name="whichcover" id="whichcover"
                  class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white
                         focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm">
            {% for file, title in cover_list %}<option value="{{ file }}" {% if (form_data.whichcover or default_cover) == file %}selected{% endif %}>{{ title }}</option>
            {% else %}<option value="">{{ _('No cover pages are set up') }}</option>{% endfor %}
          </select>
        </div>

        {% if lines|length > 1 %}
        <div>
          <label for="modem" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Send via Line') }}</label>
          <select name="modem" id="modem"
                  class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm">
            {% for device, label in lines %}<option value="{{ device }}" {% if form_data.modem == device %}selected{% endif %}>{{ label }}</option>{% endfor %}
          </select>
        </div>
        {% elif lines %}<input type="hidden" name="modem" value="{{ lines[0][0] }}" />
        {% else %}<p class="text-sm text-rose-600">{{ _('No modems configured') }}</p>{% endif %}

        <div class="sm:col-span-2">
          <label for="comments" class="block text-sm font-semibold text-slate-800 mb-1">
            {{ _('Cover Comments') }} <span class="text-xs font-normal text-slate-400">{{ _('optional') }}</span>
          </label>
          <textarea name="comments" id="comments" rows="3"
                    placeholder="{{ _('Notes or message to print on the cover sheet...') }}"
                    class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white
                           focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm resize-none">{{ form_data.comments or '' }}</textarea>
        </div>
      </div>
      </div>
    </div>

    <!-- 4. Advanced Options -->
    <details class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden group">
      <summary class="px-5 py-4 flex items-center justify-between cursor-pointer select-none list-none hover:bg-slate-50 transition-colors">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-slate-200 text-slate-500 text-xs font-bold flex items-center justify-center shrink-0">4</span>
          <span class="text-sm font-semibold text-slate-700">{{ _('Advanced Options') }}</span>
          <span class="text-xs text-slate-400">{{ _('Priority, retries, notifications') }}</span>
        </div>
        <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </summary>

      <div class="border-t border-slate-100 p-5 grid grid-cols-1 sm:grid-cols-3 gap-4">
        {% if superuser %}
        <div>
          <label for="priority" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Priority') }}</label>
          <select name="priority" id="priority"
                  class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white
                         focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm">
            {% for p in priority_list %}<option value="{{ p }}" {% if (form_data.priority or '*') == p %}selected{% endif %}>{{ '' if p == '*' else p }}</option>{% endfor %}
          </select>
        </div>
        {% endif %}

        <div>
          <label for="numtries" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Max Retries') }}</label>
          <input type="number" name="numtries" id="numtries"
                 value="{{ form_data.numtries or '' }}" min="1" max="10"
                 class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white
                        focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
          <p class="text-xs text-slate-400 mt-1">{{ _('Retries automatically on busy signal.') }}</p>
        </div>

        <div>
          <label for="killtime" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('Expire after') }}</label>
          <div class="flex gap-2">
            <input type="text" name="killtime" id="killtime" value="{{ form_data.killtime or '' }}" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm w-20" />
            <select name="killtime_unit" id="killtime_unit" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm">
              {% for unit, label in (('minutes', _('Minutes')), ('hours', _('Hours')), ('days', _('Days'))) %}<option value="{{ unit }}" {% if (form_data.killtime_unit or 'hours') == unit %}selected{% endif %}>{{ label }}</option>{% endfor %}
            </select>
          </div>
        </div>

        <div>
          <label class="inline-flex items-center gap-2 text-sm font-semibold text-slate-800 mb-1">
            <input type="checkbox" name="sendtime" id="sendtime" value="1" {% if form_data.sendtime %}checked{% endif %} class="w-4 h-4 rounded border-slate-300 text-blue-600" />
            {{ _('Schedule Send Time') }}
          </label>
          <div class="flex gap-2">
            <select name="sendtimeHour" id="sendtimeHour" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm">{% for h in hours %}<option value="{{ h }}" {% if form_data.sendtimeHour == h %}selected{% endif %}>{{ h }}</option>{% endfor %}</select>
            <select name="sendtimeMin" id="sendtimeMin" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm">{% for m in minutes %}<option value="{{ m }}" {% if form_data.sendtimeMin == m %}selected{% endif %}>{{ m }}</option>{% endfor %}</select>
          </div>
        </div>

        {% if superuser %}
        <div>
          <label for="user_tsi" class="block text-sm font-semibold text-slate-800 mb-1">{{ _('TSI ID') }}</label>
          <input type="text" name="user_tsi" id="user_tsi" value="{{ form_data.user_tsi if form_data.user_tsi is defined and form_data.user_tsi is not none else default_tsi }}" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow shadow-sm" />
        </div>
        {% endif %}

        <div class="flex items-end pb-1">
          <label class="inline-flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="notify_requeue" id="notify_requeue" value="1"
                   {% if form_data.notify_requeue %}checked{% endif %}
                   class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
            <span class="text-sm text-slate-700">{{ _('Notify on requeue') }}</span>
          </label>
        </div>
      </div>
    </details>

    <input type="hidden" name="_submit_check" value="1" />
    {% if original_fid %}
    <input type="hidden" name="refax" value="{{ original_fid }}" />
    <p class="text-xs text-slate-500">
      {{ _('The original fax is sent along.') }}
      <a href="/faxes/download/{{ original_fid }}?format=pdf" target="_blank" class="text-blue-600 hover:underline">{{ _('Download PDF') }}</a>
    </p>
    {% endif %}

    <!-- Submit -->
    <div class="flex items-center justify-between pt-1">
      <a href="/inbox" class="text-sm text-slate-500 hover:text-slate-700 font-medium transition-colors">
        ← {{ _('Cancel & return to Inbox') }}
      </a>
      <button type="submit"
              class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 active:scale-95 text-white rounded-xl text-sm font-bold shadow-sm transition-all">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
        </svg>
        {{ _('Send Fax') }}
      </button>
    </div>

  </form>
</div>

<script src="/static/js/sendfax.js" defer></script>
{% endblock %}
