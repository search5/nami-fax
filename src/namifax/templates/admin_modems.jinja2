{% extends "admin_layout.jinja2" %}

{% block title %}- NamiFAX - Admin - Modems{% endblock %}

{% block content %}
<div class="space-y-6">
  
  <!-- Header & Actions -->
  <div class="border-b border-slate-800 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-sky-950 border border-sky-800 flex items-center justify-center text-sky-400 shadow-inner">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-white tracking-tight">{{ _('Fax Modems') }}</h2>
        <p class="text-xs text-slate-400">{{ _('Configure Modems hardware devices, physical serial ports, and print-forwarding rules') }}</p>
      </div>
    </div>

    <a href="#configure-form" class="inline-flex items-center space-x-1.5 px-4 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-xs font-bold shadow-2xs transition">
      <span>+ {{ _('Configure Modems') }}</span>
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- Left: Modems List Table -->
    <div class="bg-slate-950/60 border border-slate-800/90 rounded-xl p-5 space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-800 pb-3">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider">{{ _('Active Modem Lines') }}</h3>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left border-collapse">
          <thead>
            <tr class="bg-slate-900 border-b border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
              <th scope="col" class="py-2.5 px-3">{{ _('Device') }}</th>
              <th scope="col" class="py-2.5 px-3">{{ _('Alias') }}</th>
              <th scope="col" class="py-2.5 px-3">{{ _('Contact') }}</th>
              <th scope="col" class="py-2.5 px-3">{{ _('Status') }}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            {% for m in modems %}
              <tr class="hover:bg-slate-800/40 transition">
                <td class="py-2.5 px-3 font-mono font-bold text-white">
                  <a href="/admin/modems?devid={{ m.devid }}" class="hover:text-sky-400 hover:underline transition">{{ m.device }}</a>
                </td>
                <td class="py-2.5 px-3 text-slate-300 font-medium">{{ m.alias }}</td>
                <td class="py-2.5 px-3 font-mono text-slate-400">{{ m.contact or '-' }}</td>
                <td class="py-2.5 px-3">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-300 border border-emerald-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5 animate-pulse"></span>
                    {{ m.status }}
                  </span>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Right: Configure Modems Form (Strict 5 Inputs, 1 Button Contract) -->
    <div class="bg-slate-950/60 border border-slate-800/90 rounded-xl p-5 space-y-4" id="configure-form">
      <div class="flex items-center space-x-2 border-b border-slate-800 pb-3">
        <span class="w-2 h-2 rounded-full bg-sky-500"></span>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider">
          {% if selected_modem and selected_modem.device %}{{ _('Edit Modem') }} ({{ selected_modem.device }}){% else %}{{ _('Configure Modems Device') }}{% endif %}
        </h3>
      </div>

      {% if message %}<div class="p-3 bg-emerald-950/60 border border-emerald-500/40 rounded-lg text-emerald-300 text-xs">{{ message }}</div>{% endif %}
      {% if error %}<div class="p-3 bg-rose-950/60 border border-rose-500/40 rounded-lg text-rose-300 text-xs">{{ error }}</div>{% endif %}
      <form action="/admin/modems" method="post" class="space-y-4 text-xs">
        <div>
          <label for="device" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Device') }} *</label>
          <input type="text" name="device" id="device" value="{{ selected_modem.device or '' }}" required placeholder="{{ _('e.g. ttyS0') }}" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition font-mono" />
        </div>
        <div>
          <label for="alias" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Alias') }} *</label>
          <input type="text" name="alias" id="alias" value="{{ selected_modem.alias or '' }}" required placeholder="{{ _('e.g. Main Inbound Line') }}" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition" />
        </div>
        <div>
          <label for="contact" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Contact Email') }}</label>
          <input type="text" name="contact" id="contact" value="{{ selected_modem.contact or '' }}" placeholder="operator@namifax.local" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition font-mono" />
        </div>
        <div>
          <label for="printer" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Printer') }}</label>
          <input type="text" name="printer" id="printer" value="{{ selected_modem.printer or '' }}" placeholder="lp0" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition font-mono" />
        </div>
        <div>
          <label for="category" class="block font-semibold text-slate-300 text-xs mb-1.5">{{ _('Category') }}</label>
          <select name="faxcatid" id="category" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3.5 py-2 text-xs text-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition">
            <option value=""></option>
            {% for cid, cname in categories %}<option value="{{ cid }}" {% if selected_modem.faxcatid|string == cid %}selected{% endif %}>{{ cname }}</option>{% endfor %}
          </select>
        </div>

        {% if selected_modem.devid %}
        <input type="hidden" name="devid" value="{{ selected_modem.devid }}" />
        <input type="hidden" name="device2" value="{{ selected_modem.device }}" />
        {% endif %}
        <input type="hidden" name="_submit_check" value="1" />

        <div class="pt-3 border-t border-slate-800 flex items-center justify-between">
          {% if selected_modem.devid %}
          <button type="submit" name="delete" value="1" class="px-4 py-2 bg-rose-900 hover:bg-rose-800 text-white rounded-lg font-bold text-xs transition" onclick="return confirm('{{ _('Are you sure you want to delete this modem?') }}')">{{ _('Delete') }}</button>
          {% else %}<span></span>{% endif %}
          <div class="space-x-2">
            <a href="/admin/modems" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg font-semibold text-xs transition">{{ _('Cancel') }}</a>
            {% if selected_modem.devid %}<button type="submit" name="save" value="1" class="px-6 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">{{ _('Save') }}</button>
            {% else %}<button type="submit" name="create" value="1" class="px-6 py-2 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">{{ _('Create') }}</button>{% endif %}
          </div>
        </div>
      </form>
    </div>

  </div>

  <!-- Bottom Hardware Diagnostic Note -->
  <div class="p-4 bg-slate-950/40 border border-slate-800/80 rounded-xl text-xs text-slate-400 leading-relaxed" id="explain-me">
    <p><strong class="text-slate-300">{{ _('Appliance Note:') }}</strong> {{ _('Modems configured here must correspond to physical RS-232 serial devices, USB modems, or virtual IAX modems recognized by the underlying HylaFAX server.') }}</p>
  </div>

</div>
{% endblock %}
