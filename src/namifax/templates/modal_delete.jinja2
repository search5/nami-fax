<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900/50 backdrop-blur-xs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>- NamiFAX - Delete Fax</title>
  <link rel="icon" href="/static/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="/static/css/main.css?v=3.6.0" type="text/css" />
</head>
<body class="min-h-full flex items-center justify-center p-4 sm:p-6 font-sans antialiased text-slate-800">

  <div class="w-full max-w-sm bg-white rounded-2xl shadow-2xl border border-slate-200/90 overflow-hidden text-center">
    
    <!-- Modal Header & Warning Icon -->
    <div class="p-6 pb-2 space-y-3">
      <div class="w-12 h-12 rounded-full bg-rose-50 border border-rose-200 flex items-center justify-center mx-auto text-rose-600 shadow-2xs">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>
      <div>
        <h1 class="text-sm font-bold text-slate-900 tracking-tight">{{ _('Delete Fax') }}</h1>
        <p class="text-xs text-slate-600 font-medium mt-1">{{ _('Are you sure you want to delete this fax?') }}</p>
        <p class="text-[11px] text-slate-400 mt-1">{{ _('This operation will permanently purge the fax document archive.') }}</p>
      </div>
    </div>

    <!-- Modal Form (Strict W34 Sequence Contract) -->
    <form action="/delete" method="post" class="p-6 pt-3 space-y-4 text-xs">
      <input type="hidden" name="fid" value="{{ fid }}" />
      {% if next %}<input type="hidden" name="next" value="{{ next }}" />{% endif %}
      <input type="hidden" name="_submit_check" value="1" />

      <!-- Action Buttons (Strict Sequence: Cancel -> Delete) -->
      <div class="pt-3 border-t border-slate-100 flex items-center justify-center space-x-3">
        <button type="button" onclick="window.close()" class="px-5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-semibold text-xs transition">
          {{ _('Cancel') }}
        </button>
        <button type="submit" class="px-5 py-2 bg-rose-600 hover:bg-rose-500 text-white rounded-lg font-bold text-xs shadow-2xs transition">
          {{ _('Delete') }}
        </button>
      </div>
    </form>

  </div>

</body>
</html>

