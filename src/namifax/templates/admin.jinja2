{% extends "admin_layout.jinja2" %}

{% block title %}- NamiFAX - Admin Control Panel{% endblock %}

{% block content %}
<div class="space-y-6">
  
  <!-- Dashboard Header & Appliance Status -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-slate-800 gap-4">
    <div class="flex items-center gap-3.5">
      <div class="w-11 h-11 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-blue-400 shadow-inner">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-lg font-bold text-white tracking-tight">{{ _('Dashboard Overview') }}</h1>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            {{ _('SYSTEM OPERATIONAL') }}
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-0.5">{{ _('Real-time status of fax spools, hardware serial modems, and registered users') }}</p>
      </div>
    </div>

    <!-- Quick Navigation Links (Required by Contract) -->
    <div class="flex items-center gap-2 text-xs flex-wrap">
      <a href="/admin/users" class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 font-semibold transition">{{ _('Users') }}</a>
      <a href="/admin/modems" class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 font-semibold transition">{{ _('Modems') }}</a>
      <a href="/admin/did" class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 font-semibold transition">{{ _('DID Routes') }}</a>
      <a href="/admin/syslog" class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-700 font-semibold transition">{{ _('Logs') }}</a>
    </div>
  </div>

  <!-- Key Metrics 4-Grid Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    
    <!-- Metric 1: Configured Modems -->
    <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-4 flex items-center justify-between">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">{{ _('Fax Lines') }}</p>
        <p class="text-2xl font-bold text-white mt-1">{{ modems|length if modems else 0 }}</p>
        <p class="text-[11px] text-emerald-400 mt-0.5 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> {{ _('Hardware Ready') }}
        </p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    </div>

    <!-- Metric 2: Registered Users -->
    <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-4 flex items-center justify-between">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">{{ _('Users') }}</p>
        <p class="text-2xl font-bold text-white mt-1">{{ total_users or (users|length if users else 0) }}</p>
        <p class="text-[11px] text-slate-400 mt-0.5">{{ _('Active accounts') }}</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </div>
    </div>

    <!-- Metric 3: System Engine -->
    <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-4 flex items-center justify-between">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">{{ _('Backend Core') }}</p>
        <p class="text-lg font-bold text-white mt-1">HylaFAX</p>
        <p class="text-[11px] text-slate-400 mt-0.5 font-mono">{{ hylafax_version or _('unknown') }}</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
    </div>

    <!-- Metric 4: Scheduler -->
    <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-4 flex items-center justify-between">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">{{ _('Scheduler') }}</p>
        <p class="text-lg font-bold text-white mt-1">APScheduler</p>
        <p class="text-[11px] text-emerald-400 mt-0.5">{{ _('Running') }}</p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
    </div>

  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Left: Registered Users Overview (2 Cols) -->
    <div class="lg:col-span-2 bg-slate-950/60 border border-slate-800 rounded-xl p-5 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          <h2 class="text-xs font-bold text-slate-200 uppercase tracking-wider">{{ _('Registered User Accounts') }} ({{ total_users or users|length }})</h2>
        </div>
        <a href="/admin/users" class="text-xs text-blue-400 hover:text-blue-300 hover:underline font-semibold flex items-center gap-1">
          <span>+ {{ _('Manage Users') }}</span>
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left border-collapse">
          <thead>
            <tr class="bg-slate-900 border-b border-slate-800 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
              <th scope="col" class="py-3 px-3">{{ _('Name') }}</th>
              <th scope="col" class="py-3 px-3">{{ _('Username') }}</th>
              <th scope="col" class="py-3 px-3">{{ _('Last Login') }}</th>
              <th scope="col" class="py-3 px-3">{{ _('Email') }}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            {% for u in users %}
              <tr class="hover:bg-slate-800/40 transition">
                <td class="py-3 px-3 font-semibold text-white">{{ u.name }}</td>
                <td class="py-3 px-3 font-mono text-slate-300">{{ u.username }}</td>
                <td class="py-3 px-3 text-slate-400 text-[11px] font-mono">{{ u.last_login or '-' }}</td>
                <td class="py-3 px-3 text-blue-400 font-mono">{{ u.email }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Right: Server Status & Hardware Modems (1 Col) -->
    <div class="bg-slate-950/60 border border-slate-800 rounded-xl p-5 space-y-5 text-xs">
      <div>
        <div class="flex items-center gap-2 border-b border-slate-800 pb-3 mb-3">
          <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
          <h2 class="text-xs font-bold text-slate-200 uppercase tracking-wider">{{ _('Server Status') }}</h2>
        </div>
        
        <div class="space-y-2.5 text-slate-300">
          <div class="flex items-center justify-between py-1 border-b border-slate-800/40">
            <span class="text-slate-400">HylaFAX&trade; {{ _('Core') }}</span>
            <strong class="text-white font-mono">{{ hylafax_version or _('unknown') }}</strong>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-slate-800/40">
            <span class="text-slate-400">{{ _('Database Engine') }}</span>
            <strong class="text-white font-mono">SQLAlchemy / SQLite</strong>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-slate-800/40">
            <span class="text-slate-400">{{ _('System Scheduler') }}</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-800">
              APScheduler Active
            </span>
          </div>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between border-b border-slate-800 pb-2 mb-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <h3 class="text-xs font-bold text-slate-200 uppercase tracking-wider">{{ _('Configured Modems') }}</h3>
          </div>
          <a href="/admin/modems" class="text-[11px] text-blue-400 hover:underline">Config &rarr;</a>
        </div>

        <div class="space-y-2" id="modem-status-div">
          {% set tones = {'modem-free': 'emerald', 'modem-send': 'sky', 'modem-recv': 'indigo', 'modem-wait': 'amber'} %}
          {% for m in modems %}
            {% set tone = tones.get(m.status_class, 'amber') %}
            <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-900 border border-slate-800 shadow-sm" data-state="{{ m.status_class }}">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full {{ {'emerald': 'bg-emerald-500', 'sky': 'bg-sky-500', 'indigo': 'bg-indigo-500', 'amber': 'bg-amber-500'}[tone] }} animate-pulse"></span>
                <span class="font-mono text-slate-200 font-semibold">{{ m.device }}</span>
                {% if m.alias %}
                  <span class="text-[11px] text-slate-400">({{ m.alias }})</span>
                {% endif %}
              </div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold border {{ {'emerald': 'bg-emerald-950 text-emerald-300 border-emerald-800', 'sky': 'bg-sky-950 text-sky-300 border-sky-800', 'indigo': 'bg-indigo-950 text-indigo-300 border-indigo-800', 'amber': 'bg-amber-950 text-amber-300 border-amber-800'}[tone] }}">
                {{ m.status or 'IDLE' }}
              </span>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom: Admin Quick Workflow Guide -->
  <div class="p-5 bg-slate-950/40 border border-slate-800/80 rounded-xl text-xs text-slate-400">
    <p class="font-semibold text-slate-300 text-xs mb-2">{{ _('Administrator Workflow Guide') }}</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-slate-400">
      <div class="p-3 bg-slate-900/60 rounded-lg border border-slate-800">
        <strong class="text-white block mb-1">1. User Provisioning</strong>
        Create operator accounts in <a href="/admin/users" class="text-blue-400 hover:underline">User Accounts</a>. Assign permissions to access specific fax lines or categories.
      </div>
      <div class="p-3 bg-slate-900/60 rounded-lg border border-slate-800">
        <strong class="text-white block mb-1">2. Inbound Routing</strong>
        Configure <a href="/admin/did" class="text-blue-400 hover:underline">DID Routing</a> or <a href="/admin/fax2email" class="text-blue-400 hover:underline">Fax to Email</a> rules to dispatch incoming faxes straight to destination inboxes.
      </div>
      <div class="p-3 bg-slate-900/60 rounded-lg border border-slate-800">
        <strong class="text-white block mb-1">3. Hardware &amp; Security</strong>
        Monitor serial ports in <a href="/admin/modems" class="text-blue-400 hover:underline">Fax Modems</a> and maintain caller-ID block lists in <a href="/admin/dynconf" class="text-blue-400 hover:underline">DynConf</a>.
      </div>
    </div>
  </div>

</div>
{% endblock %}
