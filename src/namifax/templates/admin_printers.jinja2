{% extends "admin_layout.jinja2" %}

{% block title %}NamiFAX - Admin - Network Printers{% endblock %}

{% block content %}
<div class="space-y-6">

  <!-- Header -->
  <div class="border-b border-slate-800 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center space-x-3">
      <div class="p-2 bg-blue-500/10 border border-blue-500/20 rounded-lg text-blue-400">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
      </div>
      <div>
        <h1 class="text-xl font-bold text-slate-100">{{ _('Network Printers') }}</h1>
        <p class="text-xs text-slate-400">{{ _('Direct RAW socket & IPP network printing dispatch for received faxes') }}</p>
      </div>
    </div>
  </div>

  <!-- Messages -->
  {% if message %}
  <div class="p-4 rounded-lg bg-emerald-950/40 border border-emerald-500/30 text-emerald-400 text-sm flex items-center gap-2">
    <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span>{{ message }}</span>
  </div>
  {% endif %}

  {% if error %}
  <div class="p-4 rounded-lg bg-rose-950/40 border border-rose-500/30 text-rose-400 text-sm flex items-center gap-2">
    <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <span>{{ error }}</span>
  </div>
  {% endif %}

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Register New Printer -->
    <div class="lg:col-span-1 bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-4">
      <h2 class="text-base font-semibold text-slate-200 border-b border-slate-800 pb-2">{{ _('Add Network Printer') }}</h2>
      <form method="POST" action="/admin/printers" class="space-y-4">
        <input type="hidden" name="action" value="add">
        
        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Printer Name') }} *</label>
          <input type="text" name="name" required placeholder="{{ _('e.g. Office HP LaserJet') }}"
                 class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Protocol') }}</label>
          <select name="protocol" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
            <option value="RAW">RAW (Port 9100 / JetDirect)</option>
            <option value="IPP">IPP (Internet Printing Protocol)</option>
            <option value="LPD">LPD / LPR (Line Printer Daemon)</option>
          </select>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="col-span-2">
            <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Host / IP') }} *</label>
            <input type="text" name="host" required placeholder="192.168.1.150"
                   class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Port') }}</label>
            <input type="number" name="port" value="9100"
                   class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Queue Name (Optional)') }}</label>
          <input type="text" name="queue_name" placeholder="lp or raw"
                 class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-400 mb-1">{{ _('Description') }}</label>
          <input type="text" name="description" placeholder="{{ _('2nd Floor Accounting Printer') }}"
                 class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-blue-500">
        </div>

        <button type="submit" class="w-full py-2 px-4 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition shadow-lg shadow-blue-500/20">
          {{ _('Register Printer') }}
        </button>
      </form>
    </div>

    <!-- Registered Printers List -->
    <div class="lg:col-span-2 bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-4">
      <h2 class="text-base font-semibold text-slate-200 border-b border-slate-800 pb-2">
        {{ _('Configured Printers') }} ({{ printers|length }})
      </h2>

      {% if not printers %}
      <div class="py-12 text-center text-slate-500 text-sm">
        {{ _('No network printers configured yet. Add one using the form on the left.') }}
      </div>
      {% else %}
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="text-xs uppercase bg-slate-950/80 text-slate-400 border-b border-slate-800">
            <tr>
              <th class="px-4 py-3">{{ _('Name') }}</th>
              <th class="px-4 py-3">{{ _('Protocol') }}</th>
              <th class="px-4 py-3">{{ _('Endpoint') }}</th>
              <th class="px-4 py-3">{{ _('Description') }}</th>
              <th class="px-4 py-3 text-right">{{ _('Actions') }}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            {% for p in printers %}
            <tr class="hover:bg-slate-800/30">
              <td class="px-4 py-3 font-semibold text-slate-200">{{ p.name }}</td>
              <td class="px-4 py-3">
                <span class="px-2 py-0.5 rounded text-xs font-mono bg-blue-500/10 text-blue-400 border border-blue-500/20">
                  {{ p.protocol }}
                </span>
              </td>
              <td class="px-4 py-3 font-mono text-xs text-slate-400">{{ p.host }}:{{ p.port }}</td>
              <td class="px-4 py-3 text-xs text-slate-400">{{ p.description or '-' }}</td>
              <td class="px-4 py-3 text-right space-x-2">
                <form method="POST" action="/admin/printers" class="inline">
                  <input type="hidden" name="action" value="test">
                  <input type="hidden" name="test_host" value="{{ p.host }}">
                  <input type="hidden" name="test_port" value="{{ p.port }}">
                  <button type="submit" class="px-2.5 py-1 text-xs rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
                    {{ _('Test Print') }}
                  </button>
                </form>
                <form method="POST" action="/admin/printers" class="inline" onsubmit="return confirm('{{ _('Are you sure you want to delete this printer?') }}')">
                  <input type="hidden" name="action" value="delete">
                  <input type="hidden" name="printer_id" value="{{ p.id }}">
                  <button type="submit" class="px-2.5 py-1 text-xs rounded bg-rose-950/40 hover:bg-rose-900/60 text-rose-300 border border-rose-800/40">
                    {{ _('Delete') }}
                  </button>
                </form>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </div>

  </div>

</div>
{% endblock %}
